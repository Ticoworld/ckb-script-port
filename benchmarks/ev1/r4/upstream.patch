+        for _ in (DEEP_FORK_POINT + 1)..=DEEP_TIP {
+            fixture.chain.mine_block(deterministic_timestamped_block);
+        }
+    }));
+    if construction.is_err() {
+        rp2c_output(
+            json!({"mode": "deep-fork-diagnostic", "case": case, "backend": BACKEND, "fork_point": DEEP_FORK_POINT, "old_tip": authority.height, "new_tip": DEEP_TIP, "protocol_selected": false, "peer_banned": false, "authority_fingerprint": chain_authority_fingerprint(fixture.chain.client_storage()), "classification": "UPSTREAM_LIMIT_OR_REJECTED", "construction": "upstream fixture rejected deeper branch"}),
+        );
+        return;
+    }
+    let prove_request = fixture.chain.build_prove_request(
+        authority.height,
+        DEEP_TIP,
+        &[],
+        DEEP_TIP - LAST_N_BLOCKS + 1,
+        LAST_N_BLOCKS,
+    );
+    peers
+        .update_last_state(
+            peer_index,
+            LastState::new(prove_request.get_last_header().to_owned()),
+        )
+        .unwrap();
+    peers
+        .update_prove_request(peer_index, prove_request)
+        .unwrap();
+    let message = rp2d_reorg_headers_and_proof(
+        &fixture,
+        authority.height,
+        DEEP_TIP,
+        LAST_N_BLOCKS,
+        DEEP_FORK_POINT,
