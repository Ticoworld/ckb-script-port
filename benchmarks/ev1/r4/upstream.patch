+        end: BlockNumber,
+    ) -> Option<Vec<packed::Bytes>> {
+        if start > end {
+            return Some(Vec::new());
+        }
+        let mut provider = None::<FilterData>;
+        let mut result = Vec::with_capacity((end - start + 1) as usize);
+        for curr_num in 0..=end {
+            let block_view = self.get_block_by_number(curr_num)?;
+            let next_provider = if let Some(mut current) = provider {
+                current.extend(&block_view);
+                current
+            } else {
+                FilterData::new(&block_view)
+            };
+            if curr_num >= start {
