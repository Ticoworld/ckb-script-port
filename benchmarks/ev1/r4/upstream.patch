+async fn g2_filter_to_h(fixture: &G2Fixture, registration_height: BlockNumber) -> Value {
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture
+        .chain
+        .create_light_client_protocol(Arc::clone(&peers));
+    let light_client_nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    establish_authority(
+        &fixture.chain,
+        &mut light_client,
+        &light_client_nc,
+        peer_index,
+        fixture.handoff_height,
+    )
+    .await;
+    register_script_at_through_service(
+        &fixture.chain,
+        Arc::clone(&peers),
+        &fixture.script,
+        ServiceScriptType::Lock,
+        registration_height,
+    );
+
+    let mut filter = fixture.chain.create_filter_protocol(Arc::clone(&peers));
+    let mut sync = fixture.chain.create_sync_protocol(Arc::clone(&peers));
+    let filter_nc = MockNetworkContext::new(SupportProtocols::Filter);
+    let sync_nc = MockNetworkContext::new(SupportProtocols::Sync);
+    let filter_data = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_data_until_linear(fixture.handoff_height)
+        .expect("G2 filter data");
+    let mut filter_hashes = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_hashes_until_linear(fixture.handoff_height)
+        .expect("G2 filter hashes");
+    filter_hashes.remove(0);
+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes.clone());
+    filter
+        .notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN)
+        .await;
+
+    let mut start = registration_height + 1;
+    for matched_height in &fixture.matched_heights {
+        if start <= *matched_height {
+            feed_filter_range_with_cached_data(
+                &fixture.chain,
+                &mut filter,
+                &peers,
+                &filter_nc,
+                peer_index,
+                start,
+                *matched_height,
+                &filter_hashes,
+                &filter_data,
+            )
+            .await;
+            finish_matched_block(
+                &fixture.chain,
+                &mut light_client,
+                &mut sync,
+                &sync_nc,
+                peer_index,
+                *matched_height,
+                fixture.handoff_height,
+            )
+            .await;
+        }
+        start = *matched_height + 1;
+    }
+    if start <= fixture.handoff_height {
+        feed_filter_range_with_cached_data(
+            &fixture.chain,
+            &mut filter,
+            &peers,
+            &filter_nc,
+            peer_index,
+            start,
+            fixture.handoff_height,
+            &filter_hashes,
+            &filter_data,
+        )
+        .await;
+    }
+
+    let handoff = fixture
+        .chain
+        .client_storage()
+        .export_typed_script_handoff(
+            fixture.script.clone(),
+            HandoffRole::Lock,
+            fixture.handoff_height,
+        )
+        .expect("G2 typed state");
+    let request_starts = filter_request_starts(&filter_nc);
+    json!({
+        "script_progress": fixture.chain.client_storage().get_filter_scripts().into_iter()
+            .find(|status| status.script == fixture.script && status.script_type == StorageScriptType::Lock)
+            .map(|status| status.block_number),
+        "request_starts": request_starts,
+        "filter_hashes": filter_hashes.iter().map(|hash| hex(hash.as_slice())).collect::<Vec<_>>(),
+        "filter_data": filter_data.iter().map(|data| hex(data.as_slice())).collect::<Vec<_>>(),
+        "index_rows": handoff.state.index_rows.len(),
+        "transaction_index_rows": handoff.state.transaction_index_rows.len(),
+        "transaction_rows": handoff.closure.transaction_rows.len(),
+        "matched_blocks": fixture.matched_heights,
+        "service_state": service_state(&fixture.chain.client_storage(), &fixture.script),
+    })
+}
