+fn g2_make_fixture(
+    storage_path: &std::path::Path,
+    chain_db_path: &std::path::Path,
+    handoff_height: BlockNumber,
+    transaction_count: usize,
+    outputs_per_transaction: usize,
+) -> G2Fixture {
+    assert!(handoff_height >= 36, "G2 handoff must leave room for activity");
+    assert!(transaction_count > 0, "G2 fixture needs at least one transaction");
+    assert!(outputs_per_transaction > 0, "G2 fixture needs at least one output");
+
+    let script = script_a();
+    let chain = MockChain::new_with_spendable_pow_at_path(storage_path)
+        .start_at_chain_db_path(chain_db_path);
+    chain.mine_to_with(10, deterministic_timestamped_block);
+
+    let mut matched_heights = Vec::new();
+    // The dummy chain's earliest blocks do not all expose a spendable
+    // cellbase output. Start in the same mature range used by the accepted
+    // RP2 fixture and consume each later cellbase at most once.
+    let mut next_cellbase = 20u64;
+    let mut first_outpoint = None;
+    let mut first_output_height = None;
+    let mut first_output_capacity = None;
+    let mut remaining = transaction_count;
+    let max_batch_count = g2_batch_size_env();
+    let match_gap = g2_match_gap_env();
+
+    while remaining > 0 {
+        let batch_count = remaining.min(max_batch_count);
+        let required_height = next_cellbase + batch_count as u64 + 4;
+        chain.mine_to_with(required_height, deterministic_timestamped_block);
+        let mut transactions = Vec::with_capacity(batch_count);
+        for offset in 0..batch_count {
+            let base = chain.get_cellbase_as_input(next_cellbase + offset as u64);
+            let input_capacity: ckb_types::core::Capacity = base
+                .output(0)
+                .expect("cellbase output")
+                .capacity()
+                .unpack();
+            let per_output = input_capacity.as_u64() / outputs_per_transaction as u64 - 1_000;
+            assert!(per_output > 10_000, "G2 output capacity is too small");
+            let outputs = (0..outputs_per_transaction)
+                .map(|_| {
+                    packed::CellOutput::new_builder()
+                        .capacity(per_output)
+                        .lock(script.clone())
+                        .build()
+                })
+                .collect::<Vec<_>>();
+            let output_data = vec![packed::Bytes::default(); outputs_per_transaction];
+            let tx = base
+                .as_advanced_builder()
+                .set_outputs(outputs)
+                .set_outputs_data(output_data)
+                .build();
+            if first_outpoint.is_none() {
+                first_outpoint = Some(packed::OutPoint::new(tx.hash(), 0));
+                first_output_capacity = Some(ckb_types::core::Capacity::shannons(per_output));
+            }
+            transactions.push(tx);
+        }
+
+        let proposals = transactions
+            .iter()
+            .map(|transaction| transaction.proposal_short_id())
+            .collect::<Vec<_>>();
+        for transaction in &transactions {
+            chain
+                .tx_pool()
+                .submit_local_test_tx(transaction.clone())
+                .expect("G2 submit transaction to tx pool");
+        }
+        chain.mine_block(|block| {
+            let number: u64 = block.header().raw().number().unpack();
+            block
+                .as_advanced_builder()
+                .timestamp(1_000u64 + number)
+                .proposals(proposals.clone())
+                .build()
+        });
+        chain.mine_blocks_with(1, deterministic_timestamped_block);
+        let inclusion_height = chain.mine_block(|block| {
+            let number: u64 = block.header().raw().number().unpack();
+            block.as_advanced_builder().timestamp(1_000u64 + number).build()
+        });
+        matched_heights.push(inclusion_height);
+        if first_output_height.is_none() {
+            first_output_height = Some(inclusion_height);
+        }
+        if match_gap > 0 {
+            next_cellbase = inclusion_height
+                .saturating_add(match_gap)
+                .checked_sub(batch_count as u64 + 7)
+                .expect("G2 match gap leaves a future cellbase");
+        } else {
+            next_cellbase += batch_count as u64;
+        }
+        remaining -= batch_count;
+    }
+
+    chain.mine_to_with(handoff_height, deterministic_timestamped_block);
+    G2Fixture {
+        chain,
+        script,
+        handoff_height,
+        matched_heights,
+        first_outpoint: first_outpoint.expect("first G2 outpoint"),
+        first_output_height: first_output_height.expect("first G2 output height"),
+        first_output_capacity: first_output_capacity.expect("first G2 output capacity"),
+    }
+}
