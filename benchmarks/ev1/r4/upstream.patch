+fn g2_validate_filter_cache_worker() {
+    let storage_path = PathBuf::from(g2_required_env("G2_STORAGE"));
+    let chain_db_path = PathBuf::from(g2_required_env("G2_CHAIN_DB"));
+    let cache_path = PathBuf::from(g2_required_env("G2_FILTER_CACHE_INPUT"));
+    let fixture = g2_reopen_fixture(&storage_path, &chain_db_path);
+    let cached: Value = serde_json::from_slice(&fs::read(cache_path).expect("read G2 filter cache"))
+        .expect("decode G2 filter cache");
+    let cached_values = cached["state"]["filter_data"]
+        .as_array()
+        .expect("cached G2 filter data")
+        .iter()
+        .map(|value| {
+            let bytes = decode_hex(value.as_str().expect("cached filter hex"))
+                .expect("cached filter bytes");
+            packed::Bytes::from_slice(&bytes).expect("cached packed filter")
+        })
+        .collect::<Vec<_>>();
+    let fresh_values = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_data_until_linear(fixture.handoff_height)
+        .expect("fresh G2 filter data");
+    assert_eq!(cached_values.len(), fresh_values.len(), "cached filter count differs");
+    for (number, (cached_filter, fresh_filter)) in cached_values.iter().zip(&fresh_values).enumerate() {
+        assert_eq!(cached_filter.as_slice(), fresh_filter.as_slice(), "cached filter bytes differ at block {number}");
+    }
+    let matching_filters = g2_validate_filter_reader(&fixture, &cached_values, &fresh_values);
+    g2_write_output(json!({
+        "mode": "g2-validate-cache",
+        "backend": BACKEND,
+        "handoff_height": fixture.handoff_height,
+        "filters": fixture.handoff_height,
+        "matching_filters": matching_filters,
+        "cache_validation": "passed",
+    }));
+}
