+    };
+    rp2c_output(
+        json!({"mode": "deep-fork-diagnostic", "case": case, "backend": BACKEND, "fork_point": DEEP_FORK_POINT, "old_tip": authority.height, "new_tip": DEEP_TIP, "protocol_selected": selected, "peer_banned": !nc.not_banned(peer_index), "authority_fingerprint": after, "classification": if selected { "RETAINED_OR_ACCEPTED" } else { "UPSTREAM_LIMIT_OR_REJECTED" }}),
