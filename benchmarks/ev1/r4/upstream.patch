+async fn g2_continue_worker() {
+    let storage_path = PathBuf::from(g2_required_env("G2_STORAGE"));
+    let chain_db_path = PathBuf::from(g2_required_env("G2_CHAIN_DB"));
+    let post_h_output = PathBuf::from(g2_required_env("G2_POST_H_OUTPUT"));
+    let post_h: Value = serde_json::from_slice(&fs::read(post_h_output).expect("read G2 post-H output"))
+        .expect("decode G2 post-H output");
+    let post_h_height = post_h["post_h_transaction_height"].as_u64().expect("post-H height");
+    let fixture = g2_reopen_fixture(&storage_path, &chain_db_path);
+    let tip = fixture.chain.shared().snapshot().tip_number();
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture
+        .chain
+        .create_light_client_protocol(Arc::clone(&peers));
+    let light_client_nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    establish_authority(
+        &fixture.chain,
+        &mut light_client,
+        &light_client_nc,
+        peer_index,
+        tip,
+    )
+    .await;
+    let mut filter = fixture.chain.create_filter_protocol(Arc::clone(&peers));
+    let mut sync = fixture.chain.create_sync_protocol(Arc::clone(&peers));
+    let filter_nc = MockNetworkContext::new(SupportProtocols::Filter);
+    let sync_nc = MockNetworkContext::new(SupportProtocols::Sync);
+    let (mut filter_hashes, mut filter_data) = if let Some(input) = std::env::var_os("G2_FILTER_CACHE_INPUT") {
+        let cached: Value = serde_json::from_slice(&fs::read(input).expect("read G2 filter cache"))
+            .expect("decode G2 filter cache");
+        let state = cached.get("state").expect("G2 filter cache state");
+        let hashes = state["filter_hashes"]
+            .as_array()
+            .expect("G2 cached filter hashes")
+            .iter()
+            .map(|value| packed::Byte32::from_slice(&decode_hex(value.as_str().expect("hash hex")).expect("G2 filter hash")).expect("G2 filter hash"))
+            .collect::<Vec<_>>();
+        let data = state["filter_data"]
+            .as_array()
+            .expect("G2 cached filter data")
+            .iter()
+            .map(|value| packed::Bytes::from_slice(&decode_hex(value.as_str().expect("filter data hex")).expect("G2 filter data")).expect("G2 packed filter data"))
+            .collect::<Vec<_>>();
+        (hashes, data)
+    } else {
+        let data = fixture
+            .chain
+            .shared()
+            .snapshot()
+            .get_block_filter_data_until_linear(tip)
+            .expect("G2 post-H filter data");
+        let hashes = fixture
+            .chain
+            .shared()
+            .snapshot()
+            .get_block_filter_hashes_until_linear(tip)
+            .expect("G2 post-H filter hashes");
+        (hashes[1..].to_vec(), data)
+    };
+    let post_h_data = post_h
+        .get("filter_data")
+        .and_then(Value::as_array)
+        .map(|values| {
+            values
+                .iter()
+                .map(|value| packed::Bytes::from_slice(&decode_hex(value.as_str().expect("post-H filter data hex")).expect("G2 post-H filter data")).expect("G2 packed post-H filter data"))
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_else(|| {
+            fixture
+                .chain
+                .shared()
+                .snapshot()
+                .get_block_filter_data_range_linear(fixture.handoff_height + 1, tip)
+                .expect("G2 post-H filter data")
+        });
+    let previous_hash = filter_hashes.last().cloned().expect("G2 handoff filter hash");
+    let mut previous_hash = previous_hash;
+    for data in post_h_data {
+        let hash = calc_filter_hash(&previous_hash, &data).pack();
+        filter_hashes.push(hash.clone());
+        filter_data.push(data);
+        previous_hash = hash;
+    }
+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes.clone());
+    filter
+        .notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN)
+        .await;
+    let starts = filter_request_starts(&filter_nc);
+    assert!(starts.iter().all(|start| *start > fixture.handoff_height));
+    feed_filter_range_with_cached_data(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        fixture.handoff_height + 1,
+        post_h_height,
+        &filter_hashes,
+        &filter_data,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        post_h_height,
+        tip,
+    )
+    .await;
+    if post_h_height < tip {
+        feed_filter_range_with_cached_data(
+            &fixture.chain,
+            &mut filter,
+            &peers,
+            &filter_nc,
+            peer_index,
+            post_h_height + 1,
+            tip,
+            &filter_hashes,
+            &filter_data,
+        )
+        .await;
+    }
+    let state = service_state(&fixture.chain.client_storage(), &fixture.script);
+    let progress = fixture
+        .chain
+        .client_storage()
+        .get_filter_scripts()
+        .into_iter()
+        .find(|status| status.script == fixture.script && status.script_type == StorageScriptType::Lock)
+        .map(|status| status.block_number);
+    g2_write_output(json!({
+        "mode": "g2-continue",
+        "backend": BACKEND,
+        "handoff_height": fixture.handoff_height,
+        "post_h_transaction_height": post_h_height,
+        "request_starts": starts,
+        "script_progress": progress,
+        "state": state,
+        "reopen_and_continue": true,
+    }));
+}
