+    let destination_chain_db =
+        PathBuf::from(g1_required_env("RP2C_DESTINATION_CHAIN_DB"));
+    let reorg_output = PathBuf::from(g1_required_env("RP2C_REORG_OUTPUT"));
+    let reorg_result: Value = serde_json::from_slice(
+        &fs::read(&reorg_output).expect("read production reorg output"),
+    )
+    .expect("decode production reorg output");
+    let replacement = reorg_result["reorg_result"]["reorg_a2_outpoint"]
+        .as_str()
+        .expect("reorg replacement");
+    let replacement_outpoint = packed::OutPoint::from_slice(
+        &decode_hex(replacement).expect("reorg replacement outpoint hex"),
+    )
+    .expect("reorg replacement outpoint");
+
+    let fixture = g1_reopened_fixture(&destination_path, &destination_chain_db, &metadata);
+    let state = service_state(fixture.chain.client_storage(), &fixture.script);
+    assert!(!has_cell_outpoint(&state, &fixture.a1_outpoint));
+    assert!(has_cell_outpoint(&state, &replacement_outpoint));
+    let progress = fixture
+        .chain
+        .client_storage()
+        .get_filter_scripts()
+        .into_iter()
+        .find(|status| {
+            status.script == fixture.script && status.script_type == StorageScriptType::Lock
+        })
+        .expect("reopened reorg script status")
+        .block_number;
+    assert_eq!(progress, 38);
+    let unrelated_scripts = fixture.chain.client_storage().get_filter_scripts();
+    assert!(unrelated_scripts.iter().any(|status| {
+        status.script == script_b() && status.script_type == StorageScriptType::Lock
+    }));
+    assert!(unrelated_scripts.iter().any(|status| {
+        status.script == fixture.script && status.script_type == StorageScriptType::Type
+    }));
+    g1_write_output(json!({
+        "mode": "production-shallow-reorg-reopen",
+        "backend": BACKEND,
+        "upstream_revision": RP2C_UPSTREAM_REVISION,
+        "handoff_height": metadata.handoff_height,
+        "fork_point": 33,
+        "fork_tip": 38,
+        "state_after_reopen": state,
+        "winning_branch_progress": progress,
+        "unrelated_state_preserved": true,
+        "restart_coherent": true,
+        "destination_owned_reorg": true,
+    }));
+}
