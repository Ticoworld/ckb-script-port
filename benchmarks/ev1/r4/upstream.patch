+fn g2_validate_filter_reader(
+    fixture: &G2Fixture,
+    cached_values: &[packed::Bytes],
+    fresh_values: &[packed::Bytes],
+) -> usize {
+    let peers = fixture.chain.create_peers();
+    let filter = fixture.chain.create_filter_protocol(peers);
+    let block_hashes = (1..=fixture.handoff_height)
+        .map(|number| fixture.chain.shared().snapshot().get_block_hash(number).expect("filter block hash"))
+        .collect::<Vec<_>>();
+    let cached_message = packed::BlockFilters::new_builder()
+        .start_number(1)
+        .block_hashes(block_hashes.clone().pack())
+        .filters(cached_values[1..].to_vec().pack())
+        .build();
+    let fresh_message = packed::BlockFilters::new_builder()
+        .start_number(1)
+        .block_hashes(block_hashes.pack())
+        .filters(fresh_values[1..].to_vec().pack())
+        .build();
+    let cached_matches = filter
+        .check_filters_data(cached_message, fixture.handoff_height as usize)
+        .expect("cached filter reader validation");
+    let fresh_matches = filter
+        .check_filters_data(fresh_message, fixture.handoff_height as usize)
+        .expect("fresh filter reader validation");
+    assert_eq!(cached_matches, fresh_matches, "cached filter match set differs");
+    cached_matches.len()
+}
