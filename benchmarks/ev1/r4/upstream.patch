+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes.clone());
+    filter
+        .notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN)
+        .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        1,
+        fixture.a_related_height - 1,
+        fixture.tip_height,
+    )
+    .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        fixture.a_related_height,
+        fixture.a_created_height,
+        fixture.tip_height,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        fixture.a_created_height,
+        fixture.tip_height,
+    )
+    .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        fixture.a_created_height + 1,
+        fixture.tip_height,
+        fixture.tip_height,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        fixture.a_spent_height,
+        fixture.tip_height,
+    )
+    .await;
+    let handoff = fixture
+        .chain
+        .client_storage()
+        .export_typed_script_handoff(
+            fixture.script.clone(),
+            HandoffRole::Lock,
+            fixture.tip_height,
+        )
+        .expect("typed export");
+    let state = service_state(fixture.chain.client_storage(), &fixture.script);
+    rp2_observer::emit(
+        "typed_handoff_exported",
+        json!({
+            "role": "lock",
+            "script_hash": format!("{:#x}", fixture.script.calc_script_hash()),
+            "cursor": handoff.progress.cursor,
+            "handoff_height": handoff.progress.handoff_height,
+            "index_rows": handoff.state.index_rows.len(),
+            "transaction_index_rows": handoff.state.transaction_index_rows.len(),
+            "transaction_closure_rows": handoff.closure.transaction_rows.len(),
+        }),
+        "approved_export_seam",
+    );
+    rp2_observer::emit(
+        "baseline_summary",
+        json!({
+            "backend": BACKEND,
+            "tip_height": fixture.tip_height,
+            "a_related_height": fixture.a_related_height,
+            "authority_height": receipt.height,
+            "script_progress": handoff.progress.cursor,
+            "filter_requests": filter_request_starts(&filter_nc),
+            "unmatched_interval": {"start": 1, "end": fixture.a_related_height - 1},
+        }),
+        "harness",
+    );
+    (_events, receipt, handoff, state)
