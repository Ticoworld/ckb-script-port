+    assert!(fixture
+        .chain
+        .client_storage()
+        .get_filter_scripts()
+        .is_empty());
+    rp2_observer::emit(
+        "authority_fingerprint_unchanged",
+        json!({"unchanged": true}),
+        "independent_authority_observer",
+    );
+    write_result(
+        "rp2b-adversarial",
+        json!({
+            "backend": BACKEND,
+            "rejected_cases": [
+                "wrong_handoff_hash",
+                "wrong_genesis",
+                "wrong_script",
+                "wrong_role",
+                "cursor_beyond_verified",
+                "stale_format",
