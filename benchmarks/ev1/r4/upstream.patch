+async fn g2_append_post_h_worker() {
+    let storage_path = PathBuf::from(g2_required_env("G2_STORAGE"));
+    let chain_db_path = PathBuf::from(g2_required_env("G2_CHAIN_DB"));
+    let fixture = g2_reopen_fixture(&storage_path, &chain_db_path);
+    let input = packed::CellInput::new(fixture.first_outpoint.clone(), 0);
+    let output = packed::CellOutput::new_builder()
+        .capacity(fixture.first_output_capacity.safe_sub(2_000u32).unwrap().pack())
+        .lock(fixture.script.clone())
+        .build();
+    let tx = TransactionView::new_advanced_builder()
+        .cell_dep(spendable_cell_dep(&fixture.chain))
+        .header_dep(
+            fixture
+                .chain
+                .shared()
+                .snapshot()
+                .get_block_hash(fixture.first_output_height)
+                .expect("G2 first output header"),
+        )
+        .input(input)
+        .output(output)
+        .output_data(packed::Bytes::default())
+        .build();
+    let proposal = tx.proposal_short_id();
+    fixture.chain.mine_block(|block| {
+        let number: u64 = block.header().raw().number().unpack();
+        block
+            .as_advanced_builder()
+            .timestamp(1_000u64 + number)
+            .proposals(vec![proposal.clone()])
+            .build()
+    });
+    fixture
+        .chain
+        .mine_blocks_with(1, deterministic_timestamped_block);
+    let post_h_height = fixture.chain.mine_block(|block| {
+        let number: u64 = block.header().raw().number().unpack();
+        block
+            .as_advanced_builder()
+            .timestamp(1_000u64 + number)
+            .transaction(tx.clone())
+            .build()
+    });
+    fixture
