+fn has_cell_outpoint(state: &Value, outpoint: &packed::OutPoint) -> bool {
+    let tx_hash = format!("{:#x}", outpoint.tx_hash());
+    let index_number: u32 = outpoint.index().unpack();
+    let index = format!("0x{index_number:x}");
+    state["cells"]["objects"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|cell| {
+            cell["out_point"]["tx_hash"].as_str() == Some(tx_hash.as_str())
+                && cell["out_point"]["index"].as_str() == Some(index.as_str())
+        })
+}
+
+fn has_transaction_hash(state: &Value, hash: &packed::Byte32) -> bool {
+    let hash = format!("{:#x}", hash);
+    state["transactions_grouped"]["objects"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|tx| tx["transaction"]["hash"] == hash)
