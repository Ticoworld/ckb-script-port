+async fn establish_authority(
+    chain: &MockRunningChain,
+    protocol: &mut LightClientProtocol,
+    nc: &MockNetworkContext,
+    peer_index: PeerIndex,
+    tip_height: BlockNumber,
+) -> AuthorityReceipt {
+    protocol.set_last_n_blocks(LAST_N_BLOCKS);
+    let snapshot = chain.shared().snapshot();
+    let prove_request = chain.build_prove_request(0, tip_height, &[], 0, protocol.last_n_blocks());
+    let last_state = LastState::new(prove_request.get_last_header().to_owned());
+    protocol
+        .peers()
+        .update_last_state(peer_index, last_state)
+        .expect("seed peer last state request");
+    protocol
+        .peers()
+        .update_prove_request(peer_index, prove_request)
+        .expect("seed peer proof request");
+
+    let last_header = snapshot
+        .get_verifiable_header_by_number(tip_height)
+        .expect("authority tip stored");
+    let headers = (0..tip_height)
+        .map(|number| {
+            snapshot
+                .get_verifiable_header_by_number(number)
+                .expect("authority header stored")
+        })
+        .collect::<Vec<_>>();
+    let numbers = headers
+        .iter()
+        .map(|header| header.header().raw().number().unpack())
+        .collect::<Vec<_>>();
+    let proof = chain.build_proof_by_numbers(tip_height, &numbers);
+    let message = packed::LightClientMessage::new_builder()
+        .set(
+            packed::SendLastStateProof::new_builder()
+                .last_header(last_header.clone())
+                .proof(proof)
+                .headers(headers.pack())
+                .build(),
+        )
+        .build();
+    protocol
+        .received(nc.context(), peer_index, message.as_bytes())
+        .await;
+    assert!(nc.not_banned(peer_index), "authority proof was rejected");
+    assert!(
+        protocol
+            .get_peer_state(&peer_index)
+            .expect("authority peer")
+            .get_prove_state()
+            .is_some(),
+        "authority proof did not produce prove state"
+    );
+
+    AuthorityReceipt {
+        genesis: snapshot.get_block_by_number(0).expect("genesis").hash(),
+        height: tip_height,
+        hash: last_header.header().calc_header_hash(),
+    }
+}
+
+#[derive(Clone)]
+struct AuthorityReceipt {
+    genesis: packed::Byte32,
+    height: BlockNumber,
+    hash: packed::Byte32,
+}
+
+#[derive(Clone)]
+struct HandoffClaim {
+    script: Script,
+    lock_role: bool,
+    height: BlockNumber,
+    hash: packed::Byte32,
+    genesis: packed::Byte32,
+}
+
+fn validate_claim(
+    storage: &Storage,
+    receipt: Option<&AuthorityReceipt>,
+    claim: &HandoffClaim,
+    expected_script: &Script,
+    expected_lock_role: bool,
+) -> Result<(), String> {
+    if &claim.script != expected_script {
+        return Err("packed Script mismatch".to_owned());
+    }
+    if claim.lock_role != expected_lock_role {
+        return Err("Script role mismatch".to_owned());
+    }
+    let receipt =
+        receipt.ok_or_else(|| "destination has no independently accepted proof".to_owned())?;
+    if claim.genesis != receipt.genesis {
+        return Err("genesis mismatch".to_owned());
+    }
+    if claim.height > receipt.height {
+        return Err("progress exceeds verified destination height".to_owned());
+    }
+    if claim.height != receipt.height || claim.hash != receipt.hash {
+        return Err("handoff hash/height does not match verified destination authority".to_owned());
+    }
+    let storage_tip = storage.get_tip_header();
+    let storage_height: BlockNumber = storage_tip.raw().number().unpack();
+    if storage_height != receipt.height || storage_tip.calc_header_hash() != receipt.hash {
+        return Err("persistent destination tip disagrees with proof receipt".to_owned());
+    }
+    Ok(())
+}
+
+fn authority_fingerprint(storage: &Storage) -> Value {
+    let rows = storage
+        .collect_iterator(
+            IteratorStart::From(Vec::new()),
+            IteratorDirection::Forward,
+            Box::new(|_| true),
+            Box::new(|_, value| Some(value.to_vec())),
+            usize::MAX,
+        )
+        .into_iter()
+        .filter(|row| row.key.first().is_some_and(|tag| *tag >= 160))
+        .map(|row| json!({"key": hex(&row.key), "value": hex(&row.value)}))
+        .collect::<Vec<_>>();
+    json!({"authority_rows": rows})
+}
+
+fn record_fingerprint(stage: &str, fingerprint: &Value) {
+    rp2_observer::emit(
+        "authority_fingerprint",
+        json!({"stage": stage, "fingerprint": fingerprint}),
+        "authority_observer",
+    );
+}
+
+fn write_result(name: &str, value: Value) {
+    let path = run_root()
+        .join("results")
+        .join(format!("{}-{}.json", BACKEND, name));
+    fs::create_dir_all(path.parent().expect("result parent")).expect("create result directory");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&value).expect("serialize RP2 result"),
+    )
+    .expect("write RP2 result");
+}
