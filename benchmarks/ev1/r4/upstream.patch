+async fn process_rp2d_reorg(
+    fixture: &Fixture,
+    light_client: LightClientProtocol,
+    peers: Arc<crate::protocols::Peers>,
+    peer_index: PeerIndex,
+    authority: &AuthorityReceipt,
+    case: &str,
+) -> Value {
+    process_rp2d_reorg_at(fixture, light_client, peers, peer_index, authority, case, 33, 38)
+        .await
+}
+
+async fn process_rp2d_reorg_at(
+    fixture: &Fixture,
+    mut light_client: LightClientProtocol,
+    peers: Arc<crate::protocols::Peers>,
+    peer_index: PeerIndex,
+    authority: &AuthorityReceipt,
+    case: &str,
+    fork_point: BlockNumber,
+    requested_tip: BlockNumber,
+) -> Value {
+    let (fork_tip, reorg_a2) = append_rp2d_reorg_branch_at(fixture, fork_point, requested_tip);
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let prove_request = fixture.chain.build_prove_request(
+        authority.height,
+        fork_tip,
+        &[],
+        fork_tip - LAST_N_BLOCKS + 1,
+        LAST_N_BLOCKS,
+    );
+    let last_state = LastState::new(prove_request.get_last_header().to_owned());
+    peers
+        .update_last_state(peer_index, last_state)
+        .expect("update fork last state");
+    peers
+        .update_prove_request(peer_index, prove_request)
+        .expect("update fork prove request");
+    let message = rp2d_reorg_headers_and_proof(
+        fixture,
+        authority.height,
+        fork_tip,
+        LAST_N_BLOCKS,
+        fork_point,
+    );
+    light_client
+        .received(nc.context(), peer_index, message.as_bytes())
+        .await;
+    assert!(nc.not_banned(peer_index), "real fork proof was rejected");
+    let prove_state = light_client
+        .get_peer_state(&peer_index)
+        .expect("fork peer state")
+        .get_prove_state()
+        .expect("fork prove state")
+        .to_owned();
+    let fork_header: ckb_types::packed::VerifiableHeader = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_verifiable_header_by_number(fork_tip)
+        .unwrap();
+    let fork_header: VerifiableHeader = fork_header.into();
+    assert!(prove_state.is_same_as(&fork_header));
+    let reorg_event = json!({
+        "case": case,
+        "old_tip": authority.height,
+        "fork_point": fork_point,
+        "new_tip": fork_tip,
+        "reorg_last_headers": prove_state.get_reorg_last_headers().iter().map(|h| h.number()).collect::<Vec<_>>(),
+        "storage_min_filtered_after_rollback": fixture.chain.client_storage().get_min_filtered_block_number(),
+    });
+    rp2_observer::emit(
+        "reorg_selected_by_protocol",
+        reorg_event,
+        "normal_chain_proof",
+    );
+    rp2_observer::emit(
+        "reorg_state_after_rollback",
+        json!({
+            "old_a1_present": has_cell_outpoint(&service_state(fixture.chain.client_storage(), &fixture.script), &fixture.a1_outpoint),
+            "script_index_rows": raw_script_index_count(fixture.chain.client_storage(), &fixture.script),
+            "min_filtered": fixture.chain.client_storage().get_min_filtered_block_number(),
+        }),
+        "normal_chain_proof",
+    );
+
+    let mut filter = fixture.chain.create_filter_protocol(Arc::clone(&peers));
+    let mut sync = fixture.chain.create_sync_protocol(Arc::clone(&peers));
+    let filter_nc = MockNetworkContext::new(SupportProtocols::Filter);
+    let sync_nc = MockNetworkContext::new(SupportProtocols::Sync);
+    let mut filter_hashes = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_hashes_until(fork_tip)
+        .expect("fork filter hashes");
+    filter_hashes.remove(0);
+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes);
+    filter
+        .notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN)
+        .await;
+    let starts = filter_request_starts(&filter_nc);
+    let replacement_height = fork_point + 3;
+    assert!(
+        starts.iter().any(|start| *start == fork_point + 1),
+        "fork filtering did not restart at {}: {starts:?}",
+        fork_point + 1
+    );
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        fork_point + 1,
+        replacement_height - 1,
+        fork_tip,
+    )
+    .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        replacement_height,
+        fork_tip,
+        fork_tip,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        replacement_height,
+        fork_tip,
