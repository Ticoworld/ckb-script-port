+fn filter_request_starts(nc: &MockNetworkContext) -> Vec<BlockNumber> {
+    nc.sent_messages()
+        .borrow()
+        .iter()
+        .filter_map(|(_, _, data)| {
+            let message = packed::BlockFilterMessageReader::from_slice(data).ok()?;
+            match message.to_enum() {
+                packed::BlockFilterMessageUnionReader::GetBlockFilters(content) => {
+                    Some(content.start_number().unpack())
+                }
+                _ => None,
+            }
+        })
+        .collect()
+}
