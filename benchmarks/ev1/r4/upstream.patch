+async fn finish_matched_blocks(
+    chain: &MockRunningChain,
+    light_client: &mut LightClientProtocol,
+    sync: &mut SyncProtocol,
+    nc: &MockNetworkContext,
+    peer_index: PeerIndex,
+    matched_heights: &[BlockNumber],
+    tip_height: BlockNumber,
+) {
+    let snapshot = chain.shared().snapshot();
+    let last_header = snapshot
+        .get_verifiable_header_by_number(tip_height)
+        .expect("proof tip");
+    let headers = matched_heights
+        .iter()
+        .map(|height| {
+            snapshot
+                .get_header_by_number(*height)
+                .expect("matched header")
+                .data()
+        })
+        .collect::<Vec<_>>();
+    let proof = chain.build_proof_by_numbers(tip_height, matched_heights);
+    let proof_message = packed::LightClientMessage::new_builder()
+        .set(
+            packed::SendBlocksProof::new_builder()
+                .last_header(last_header)
+                .proof(proof)
+                .headers(headers.pack())
+                .build(),
+        )
+        .build();
+    light_client
+        .received(nc.context(), peer_index, proof_message.as_bytes())
+        .await;
+    assert!(
+        nc.not_banned(peer_index),
+        "matched block proof was rejected"
+    );
+
+    for matched_height in matched_heights {
+        let block = snapshot
+            .get_block_by_number(*matched_height)
+            .expect("matched block")
+            .data();
+        let sync_message = packed::SyncMessage::new_builder()
+            .set(packed::SendBlock::new_builder().block(block).build())
+            .build();
+        sync.received(nc.context(), peer_index, sync_message.as_bytes())
+            .await;
+        assert!(
+            nc.not_banned(peer_index),
+            "matched block was rejected by sync"
+        );
+    }
+}
