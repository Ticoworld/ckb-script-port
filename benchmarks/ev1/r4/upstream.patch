+    /// Linear-time variants for the scaled protocol fixture. The historical
+    /// helpers above intentionally rebuild provider state for each block and
+    /// are useful for small tests, but become quadratic at H=10,000.
+    fn get_block_filter_data_until_linear(&self, num: BlockNumber) -> Option<Vec<packed::Bytes>> {
+        let mut provider = None::<FilterData>;
+        let mut result = Vec::with_capacity(num as usize + 1);
+        for curr_num in 0..=num {
+            let block_view = self.get_block_by_number(curr_num)?;
+            let next_provider = if let Some(mut current) = provider {
+                current.extend(&block_view);
+                current
+            } else {
+                FilterData::new(&block_view)
+            };
+            let (block_filter_vec, missing_out_points) =
+                build_filter_data(&next_provider, &block_view.transactions());
+            if !missing_out_points.is_empty() {
+                for out_point in missing_out_points {
+                    error!("Can't find input cell for out_point: {out_point:#x}");
+                }
+                panic!("block#{curr_num} has missing out points!");
+            }
+            result.push(block_filter_vec.pack());
+            provider = Some(next_provider);
+        }
+        Some(result)
+    }
+
+    fn get_block_filter_hashes_until_linear(&self, num: BlockNumber) -> Option<Vec<packed::Byte32>> {
+        let filters = self.get_block_filter_data_until_linear(num)?;
+        let mut previous = packed::Byte32::zero();
+        let mut hashes = Vec::with_capacity(filters.len());
+        for filter in filters {
+            let hash = calc_filter_hash(&previous, &filter).pack();
+            hashes.push(hash.clone());
+            previous = hash;
+        }
+        Some(hashes)
+    }
+
+    fn get_block_filter_data_range_linear(
