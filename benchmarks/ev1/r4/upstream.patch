+// RP2-C is deliberately an experimental process boundary around the
+// already-accepted typed RP2-B seam. The wire model below is not a public
+// package format: it encodes the typed handoff object with canonical ordering
+// and a payload digest so separate feature-specific test processes can exchange
+// semantics without exchanging backend keys or files.
+const RP2C_ARTIFACT_VERSION: &str = "rp2-cross-backend-fixture-v1";
+const RP2C_UPSTREAM_REVISION: &str = "12e29522ab7e078ada704d4ac04cbc0498009b7b";
+const RP2C_MAX_ARTIFACT_BYTES: usize = 4 * 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cWireRow {
+    key_hex: String,
+    value_hex: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cWireState {
+    index_rows: Vec<Rp2cWireRow>,
+    transaction_index_rows: Vec<Rp2cWireRow>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cWireClosure {
+    transaction_rows: Vec<Rp2cWireRow>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cWireProgress {
+    cursor: u64,
+    handoff_height: u64,
+    handoff_hash: String,
+    genesis_hash: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cWirePayload {
+    script_hex: String,
+    role: String,
+    state: Rp2cWireState,
+    closure: Rp2cWireClosure,
+    progress: Rp2cWireProgress,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rp2cArtifactEnvelope {
+    format_version: String,
+    source_backend: String,
+    source_process_id: String,
+    upstream_revision: String,
+    payload_hex: String,
+    payload_digest: String,
+}
+
+fn decode_hex(value: &str) -> Result<Vec<u8>, String> {
+    if !value.starts_with("0x") || value.len() % 2 != 0 {
+        return Err("hex value must have 0x prefix and an even number of digits".to_owned());
+    }
+    let bytes = value.as_bytes();
+    let mut output = Vec::with_capacity((bytes.len() - 2) / 2);
+    for pair in bytes[2..].chunks_exact(2) {
+        let high = (pair[0] as char)
+            .to_digit(16)
+            .ok_or_else(|| "invalid hex digit".to_owned())?;
+        let low = (pair[1] as char)
+            .to_digit(16)
+            .ok_or_else(|| "invalid hex digit".to_owned())?;
+        output.push(((high << 4) | low) as u8);
+    }
+    if hex(&output) != value {
+        return Err("hex value is not canonical lowercase".to_owned());
+    }
+    Ok(output)
+}
+
+fn wire_row(row: &HandoffRow) -> Rp2cWireRow {
+    Rp2cWireRow {
+        key_hex: hex(&row.key),
+        value_hex: hex(&row.value),
+    }
+}
+
+fn wire_rows(rows: &[HandoffRow]) -> Vec<Rp2cWireRow> {
+    let mut rows = rows.iter().map(wire_row).collect::<Vec<_>>();
+    rows.sort_by(|a, b| a.key_hex.cmp(&b.key_hex));
+    rows
+}
+
+fn wire_payload(handoff: &TypedScriptHandoff) -> Rp2cWirePayload {
+    Rp2cWirePayload {
+        script_hex: hex(handoff.script.as_slice()),
+        role: match handoff.role {
+            HandoffRole::Lock => "lock".to_owned(),
+            HandoffRole::Type => "type".to_owned(),
+        },
+        state: Rp2cWireState {
+            index_rows: wire_rows(&handoff.state.index_rows),
+            transaction_index_rows: wire_rows(&handoff.state.transaction_index_rows),
+        },
+        closure: Rp2cWireClosure {
+            transaction_rows: wire_rows(&handoff.closure.transaction_rows),
+        },
+        progress: Rp2cWireProgress {
+            cursor: handoff.progress.cursor,
+            handoff_height: handoff.progress.handoff_height,
+            handoff_hash: format!("{:#x}", handoff.progress.handoff_hash),
+            genesis_hash: format!("{:#x}", handoff.progress.genesis_hash),
+        },
+    }
+}
+
+fn wire_row_to_handoff(row: &Rp2cWireRow) -> Result<HandoffRow, String> {
+    Ok(HandoffRow {
+        key: decode_hex(&row.key_hex)?,
+        value: decode_hex(&row.value_hex)?,
+    })
+}
+
+fn validate_wire_row_order(rows: &[Rp2cWireRow], label: &str) -> Result<(), String> {
+    let mut previous: Option<&str> = None;
+    for row in rows {
+        decode_hex(&row.key_hex)?;
+        decode_hex(&row.value_hex)?;
+        if let Some(previous) = previous {
+            if previous >= row.key_hex.as_str() {
+                return Err(format!("{label} rows are not strictly canonical"));
+            }
+        }
+        previous = Some(row.key_hex.as_str());
+    }
+    Ok(())
+}
+
+fn wire_to_handoff(payload: &Rp2cWirePayload) -> Result<TypedScriptHandoff, String> {
+    validate_wire_row_order(&payload.state.index_rows, "index")?;
+    validate_wire_row_order(&payload.state.transaction_index_rows, "transaction-index")?;
+    validate_wire_row_order(&payload.closure.transaction_rows, "closure")?;
+    let script = Script::from_slice(&decode_hex(&payload.script_hex)?)
+        .map_err(|err| format!("invalid packed Script: {err}"))?;
+    let role = match payload.role.as_str() {
+        "lock" => HandoffRole::Lock,
+        "type" => HandoffRole::Type,
+        _ => return Err("unknown Script role".to_owned()),
+    };
+    let handoff_hash = packed::Byte32::from_slice(&decode_hex(&payload.progress.handoff_hash)?)
+        .map_err(|err| format!("invalid handoff hash: {err}"))?;
+    let genesis_hash = packed::Byte32::from_slice(&decode_hex(&payload.progress.genesis_hash)?)
+        .map_err(|err| format!("invalid genesis hash: {err}"))?;
+    Ok(TypedScriptHandoff {
+        format_version: 1,
+        script,
+        role,
+        state: ScriptDerivedState {
+            index_rows: payload
+                .state
+                .index_rows
+                .iter()
+                .map(wire_row_to_handoff)
+                .collect::<Result<Vec<_>, _>>()?,
+            transaction_index_rows: payload
+                .state
+                .transaction_index_rows
+                .iter()
+                .map(wire_row_to_handoff)
+                .collect::<Result<Vec<_>, _>>()?,
+        },
+        closure: HistoricalClosure {
+            transaction_rows: payload
+                .closure
+                .transaction_rows
+                .iter()
+                .map(wire_row_to_handoff)
+                .collect::<Result<Vec<_>, _>>()?,
+        },
+        progress: ScriptProgress {
+            cursor: payload.progress.cursor,
+            handoff_height: payload.progress.handoff_height,
+            handoff_hash,
+            genesis_hash,
+        },
+    })
+}
+
+fn artifact_envelope(
+    payload: &Rp2cWirePayload,
+    source_backend: String,
+    source_process_id: String,
+) -> Result<(Rp2cArtifactEnvelope, Vec<u8>, String), String> {
+    let payload_bytes = serde_json::to_vec(payload).map_err(|err| err.to_string())?;
+    let payload_digest = format!("{:#x}", packed::CellOutput::calc_data_hash(&payload_bytes));
+    let envelope = Rp2cArtifactEnvelope {
+        format_version: RP2C_ARTIFACT_VERSION.to_owned(),
+        source_backend,
+        source_process_id,
+        upstream_revision: RP2C_UPSTREAM_REVISION.to_owned(),
+        payload_hex: hex(&payload_bytes),
+        payload_digest: payload_digest.clone(),
+    };
+    Ok((envelope, payload_bytes, payload_digest))
+}
+
+fn write_artifact(
+    path: &std::path::Path,
+    payload: &Rp2cWirePayload,
+    source_backend: &str,
+    source_process_id: &str,
+) -> Result<String, String> {
+    let (envelope, _payload_bytes, digest) = artifact_envelope(
+        payload,
+        source_backend.to_owned(),
+        source_process_id.to_owned(),
+    )?;
+    let bytes = serde_json::to_vec(&envelope).map_err(|err| err.to_string())?;
+    if bytes.len() > RP2C_MAX_ARTIFACT_BYTES {
+        return Err("artifact exceeds experiment limit".to_owned());
+    }
+    fs::create_dir_all(
+        path.parent()
+            .ok_or_else(|| "artifact parent missing".to_owned())?,
+    )
+    .map_err(|err| err.to_string())?;
+    fs::write(path, bytes).map_err(|err| err.to_string())?;
+    Ok(digest)
+}
+
+fn read_artifact(
+    path: &std::path::Path,
+) -> Result<(Rp2cArtifactEnvelope, TypedScriptHandoff, String), String> {
+    let bytes = fs::read(path).map_err(|err| err.to_string())?;
+    if bytes.is_empty() || bytes.len() > RP2C_MAX_ARTIFACT_BYTES {
+        return Err("artifact length is outside experiment bounds".to_owned());
+    }
+    let envelope: Rp2cArtifactEnvelope = serde_json::from_slice(&bytes)
+        .map_err(|err| format!("invalid artifact envelope: {err}"))?;
+    if envelope.format_version != RP2C_ARTIFACT_VERSION {
+        return Err("unknown experimental artifact version".to_owned());
+    }
+    if envelope.upstream_revision != RP2C_UPSTREAM_REVISION {
+        return Err("artifact upstream revision mismatch".to_owned());
+    }
+    let payload_bytes = decode_hex(&envelope.payload_hex)?;
+    let payload_digest = format!("{:#x}", packed::CellOutput::calc_data_hash(&payload_bytes));
+    if envelope.payload_digest != payload_digest {
+        return Err("artifact payload digest mismatch".to_owned());
+    }
+    let payload: Rp2cWirePayload =
+        serde_json::from_slice(&payload_bytes).map_err(|err| format!("invalid payload: {err}"))?;
+    let canonical = serde_json::to_vec(&payload).map_err(|err| err.to_string())?;
+    if canonical != payload_bytes {
+        return Err("artifact payload is not canonical".to_owned());
+    }
+    let handoff = wire_to_handoff(&payload)?;
+    Ok((envelope, handoff, payload_digest))
+}
+
+fn rp2c_required_env(name: &str) -> String {
+    std::env::var(name).unwrap_or_else(|_| panic!("missing {name} environment variable"))
+}
+
+fn rp2c_output(value: Value) {
+    let path = PathBuf::from(rp2c_required_env("RP2C_OUTPUT"));
+    fs::create_dir_all(path.parent().expect("RP2C_OUTPUT parent")).expect("create RP2C output dir");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&value).expect("serialize RP2C output"),
+    )
+    .expect("write RP2C output");
+}
+
+fn write_rp2c_artifact_variants(
+    handoff: &TypedScriptHandoff,
+    valid_path: &std::path::Path,
+) -> Result<Value, String> {
+    let source_backend = BACKEND.to_owned();
+    let source_process_id = rp2c_required_env("RP2C_PROCESS_ID");
+    let payload = wire_payload(handoff);
+    let valid_digest = write_artifact(valid_path, &payload, &source_backend, &source_process_id)?;
+    let valid_bytes = fs::read(valid_path).map_err(|err| err.to_string())?;
+    let artifact_dir = valid_path
+        .parent()
+        .ok_or_else(|| "artifact parent missing".to_owned())?;
+
+    let truncated = artifact_dir.join("truncated.json");
+    fs::write(&truncated, &valid_bytes[..valid_bytes.len() / 2]).map_err(|err| err.to_string())?;
+
+    let (mut digest_mismatch, _, _) =
+        artifact_envelope(&payload, source_backend.clone(), source_process_id.clone())?;
+    digest_mismatch.payload_digest = format!("0x{}", "00".repeat(32));
+    let digest_mismatch_path = artifact_dir.join("digest-mismatch.json");
+    fs::write(
+        &digest_mismatch_path,
+        serde_json::to_vec(&digest_mismatch).map_err(|err| err.to_string())?,
+    )
+    .map_err(|err| err.to_string())?;
+
+    let (mut wrong_version, _, _) =
+        artifact_envelope(&payload, source_backend.clone(), source_process_id.clone())?;
+    wrong_version.format_version = "rp2-cross-backend-fixture-v999".to_owned();
+    let wrong_version_path = artifact_dir.join("wrong-version.json");
+    fs::write(
+        &wrong_version_path,
+        serde_json::to_vec(&wrong_version).map_err(|err| err.to_string())?,
+    )
+    .map_err(|err| err.to_string())?;
+
+    let mut duplicate_payload = payload.clone();
+    duplicate_payload
+        .state
+        .index_rows
+        .push(duplicate_payload.state.index_rows[0].clone());
+    let duplicate_path = artifact_dir.join("duplicate-item.json");
+    write_artifact(
+        &duplicate_path,
+        &duplicate_payload,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut reordered_payload = payload.clone();
+    reordered_payload.state.transaction_index_rows.reverse();
+    let reordered_path = artifact_dir.join("reordered.json");
+    let reordered_digest = write_artifact(
+        &reordered_path,
+        &reordered_payload,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let tampered_backend = artifact_envelope(
+        &payload,
+        if BACKEND == "rocksdb" {
+            "sqlite"
+        } else {
+            "rocksdb"
+        }
+        .to_owned(),
+        source_process_id.clone(),
+    )?
+    .0;
+    let tampered_backend_path = artifact_dir.join("tampered-backend.json");
+    fs::write(
+        &tampered_backend_path,
+        serde_json::to_vec(&tampered_backend).map_err(|err| err.to_string())?,
+    )
+    .map_err(|err| err.to_string())?;
+
+    let mut wrong_genesis = payload.clone();
+    wrong_genesis.progress.genesis_hash = format!("0x{}", "11".repeat(32));
+    let wrong_genesis_path = artifact_dir.join("wrong-genesis.json");
+    write_artifact(
+        &wrong_genesis_path,
+        &wrong_genesis,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut wrong_hash = payload.clone();
+    wrong_hash.progress.handoff_hash = format!("0x{}", "22".repeat(32));
+    let wrong_hash_path = artifact_dir.join("wrong-handoff-hash.json");
+    write_artifact(
+        &wrong_hash_path,
+        &wrong_hash,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut wrong_script = payload.clone();
+    wrong_script.script_hex = hex(script_b().as_slice());
+    let wrong_script_path = artifact_dir.join("wrong-script.json");
+    write_artifact(
+        &wrong_script_path,
+        &wrong_script,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut wrong_role = payload.clone();
+    wrong_role.role = "type".to_owned();
+    let wrong_role_path = artifact_dir.join("wrong-role.json");
+    write_artifact(
+        &wrong_role_path,
+        &wrong_role,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut cursor_beyond = payload.clone();
+    cursor_beyond.progress.cursor = cursor_beyond.progress.handoff_height + 1;
+    let cursor_beyond_path = artifact_dir.join("cursor-beyond.json");
+    write_artifact(
+        &cursor_beyond_path,
+        &cursor_beyond,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    let mut forged_c = payload.clone();
+    forged_c.closure.transaction_rows.push(Rp2cWireRow {
+        key_hex: hex(&vec![160u8; 33]),
+        value_hex: hex(&[]),
+    });
+    let forged_c_path = artifact_dir.join("forged-c-state.json");
+    write_artifact(
+        &forged_c_path,
+        &forged_c,
+        &source_backend,
+        &source_process_id,
+    )?;
+
+    Ok(json!({
+        "valid": {"path": valid_path, "digest": valid_digest},
+        "variants": {
