+        first_outpoint: packed::OutPoint::from_slice(
+            &decode_hex(&metadata.first_outpoint).expect("G2 outpoint hex"),
+        )
+        .expect("G2 first outpoint"),
+        first_output_height: metadata.first_output_height,
+        first_output_capacity: ckb_types::core::Capacity::shannons(metadata.first_output_capacity),
+    }
