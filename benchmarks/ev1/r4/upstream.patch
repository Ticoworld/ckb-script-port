+#[derive(Serialize, Deserialize)]
+struct G2Metadata {
+    workload: String,
+    handoff_height: BlockNumber,
+    handoff_hash: String,
+    genesis_hash: String,
+    script_hex: String,
+    transaction_count: usize,
+    outputs_per_transaction: usize,
+    matched_heights: Vec<BlockNumber>,
+    first_outpoint: String,
+    first_output_height: BlockNumber,
+    first_output_capacity: u64,
+}
+
+struct G2Fixture {
+    chain: MockRunningChain,
+    script: Script,
+    handoff_height: BlockNumber,
+    matched_heights: Vec<BlockNumber>,
+    first_outpoint: packed::OutPoint,
+    first_output_height: BlockNumber,
+    first_output_capacity: ckb_types::core::Capacity,
+}
+
+fn g2_required_env(name: &str) -> String {
+    std::env::var(name).unwrap_or_else(|_| panic!("missing {name} environment variable"))
+}
+
+fn g2_usize_env(name: &str) -> usize {
+    g2_required_env(name)
+        .parse()
+        .unwrap_or_else(|_| panic!("invalid {name} integer"))
+}
+
+fn g2_batch_size_env() -> usize {
+    std::env::var("G2_BATCH_SIZE")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .filter(|value| *value > 0)
+        .unwrap_or(20)
+}
+
+fn g2_match_gap_env() -> u64 {
+    std::env::var("G2_MATCH_GAP")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0)
+}
+
+fn g2_height_env(name: &str) -> BlockNumber {
+    g2_required_env(name)
+        .parse()
+        .unwrap_or_else(|_| panic!("invalid {name} block height"))
+}
