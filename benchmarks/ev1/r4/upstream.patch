+fn rp2d_reopen_worker() {
+    let db_path = PathBuf::from(rp2d_required_env("RP2D_DB_PATH"));
+    let fixture = make_fixture_at_path(&db_path);
+    let script = script_a();
+    let scripts = fixture.chain.client_storage().get_filter_scripts();
+    let a_registered = scripts
+        .iter()
+        .any(|ss| ss.script == script && ss.script_type == StorageScriptType::Lock);
+    let b_registered = scripts
+        .iter()
+        .any(|ss| ss.script == script_b() && ss.script_type == StorageScriptType::Lock);
+    let a_type_registered = scripts
+        .iter()
+        .any(|ss| ss.script == script && ss.script_type == StorageScriptType::Type);
+    let state_result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        if a_registered {
+            Some(service_state(fixture.chain.client_storage(), &script))
+        } else {
+            None
+        }
+    }));
+    let state = state_result.as_ref().ok().and_then(|value| value.as_ref());
+    let a1_present = state
+        .map(|value| has_cell_outpoint(value, &fixture.a1_outpoint))
+        .unwrap_or(false);
+    let a_progress = scripts
+        .iter()
+        .find(|ss| ss.script == script && ss.script_type == StorageScriptType::Lock)
+        .map(|ss| ss.block_number);
+    let global_minimum = fixture
+        .chain
+        .client_storage()
+        .get_min_filtered_block_number();
+    let s_complete = a_registered && a1_present;
+    let h_complete = a1_present;
+    let p_complete = a_progress == Some(fixture.tip_height);
+    let expected = rp2d_required_env("RP2D_EXPECTED_STATE");
+    let consistency = if state_result.is_err() {
+        "TORN_INVALID"
+    } else if expected == "OLD_COMPLETE" && !a_registered && b_registered && a_type_registered {
+        "OLD_COMPLETE"
+    } else if expected == "NEW_COMPLETE"
+        && a_registered
+        && a1_present
+        && b_registered
+        && a_type_registered
+    {
+        "NEW_COMPLETE"
+    } else if expected == "ANY" && !a_registered && b_registered && a_type_registered {
+        "OLD_COMPLETE"
+    } else if expected == "ANY" && a_registered && a1_present && b_registered && a_type_registered {
+        "NEW_COMPLETE"
+    } else {
+        "TORN_INVALID"
+    };
+    if expected != "ANY" {
+        assert_eq!(
+            consistency, expected,
+            "persistent backend reopened in an unexpected state"
+        );
+    }
+    rp2c_output(json!({
+        "mode": "reopen",
+        "backend": BACKEND,
+        "expected": expected,
+        "consistency": consistency,
+        "script_count": scripts.len(),
+        "a_registered": a_registered,
+        "a1_live": a1_present,
+        "a_progress": a_progress,
+        "global_minimum": global_minimum,
+        "s_complete": s_complete,
+        "h_complete": h_complete,
+        "p_complete": p_complete,
+        "b_registered": b_registered,
+        "a_type_registered": a_type_registered,
+        "authority_fingerprint": chain_authority_fingerprint(fixture.chain.client_storage()),
+    }));
+}
