+//! RP2-A: real-upstream authority and replay measurement harness.
+//!
+//! This module is test-only. It deliberately contains no D2 importer. The
+//! normal control drives the actual filter/proof/synchronizer path; the
+//! adversarial controls use direct writes only to prove that the verifier can
+//! identify those shortcuts.
+
+use std::{fs, path::PathBuf, sync::Arc};
+
+use ckb_network::{CKBProtocolHandler, PeerIndex, SupportProtocols};
+use ckb_store::ChainStore;
+use ckb_types::{
+    bytes::Bytes,
+    core::{BlockNumber, BlockView, ScriptHashType, TransactionView},
+    packed::{self, Script},
+    prelude::*,
+    utilities::{calc_filter_hash, merkle_mountain_range::VerifiableHeader},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+use crate::{
+    protocols::{
+        FilterProtocol, LastState, LightClientProtocol, PendingTxs, SyncProtocol,
+        GET_BLOCK_FILTERS_TOKEN,
+    },
+    rp2_handoff::{
+        DestinationAuthority, HandoffRole, HandoffRow, HistoricalClosure, ScriptDerivedState,
+        ScriptProgress, TypedScriptHandoff, TypedScriptHandoffStorage,
+    },
+    rp2_observer,
+    service::{
+        LightClientChainService, ScriptStatus as ServiceScriptStatus,
+        ScriptType as ServiceScriptType, SetScriptsCommand as ServiceSetScriptsCommand,
+    },
+    storage::{
+        IteratorDirection, IteratorStart, LightClientStorage, ScriptStatus as StorageScriptStatus,
+        ScriptType as StorageScriptType, SetScriptsCommand, Storage, StorageBackend,
+        StorageWithChainData,
+    },
+    tests::{
+        prelude::*,
+        utils::{setup, MockChain, MockNetworkContext, MockRunningChain},
+        ALWAYS_SUCCESS_BIN, ALWAYS_SUCCESS_SCRIPT,
+    },
+};
+
+const TIP_HEIGHT: BlockNumber = 36;
+const LAST_N_BLOCKS: BlockNumber = 3;
+
+#[cfg(feature = "sqlite")]
+const BACKEND: &str = "sqlite";
+#[cfg(not(feature = "sqlite"))]
+const BACKEND: &str = "rocksdb";
+
+struct EventSession;
+
+impl Drop for EventSession {
+    fn drop(&mut self) {
+        let _ = rp2_observer::finish();
+    }
+}
+
+fn event_dir() -> PathBuf {
+    std::env::var_os("RP2_EVENT_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| std::env::temp_dir().join("d2-rp2a-events"))
+}
+
+fn run_root() -> PathBuf {
+    std::env::var_os("RP2_RUN_ROOT")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| std::env::temp_dir().join("d2-rp2a-run"))
+}
+
+fn start_events(
+    case: &str,
+    expected_classification: &str,
+    requires_authority: bool,
+) -> EventSession {
+    let run_id = format!("rp2a-{}-{}", BACKEND, case);
+    let path = event_dir().join(format!("{}-{}.jsonl", BACKEND, case));
+    rp2_observer::start(&path, run_id, case, BACKEND).expect("start RP2 event log");
+    rp2_observer::emit(
+        "case_started",
+        json!({
+            "case": case,
+            "expected_classification": expected_classification,
+            "requires_authority": requires_authority,
+        }),
+        "harness",
+    );
+    EventSession
+}
+
+fn hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    let mut output = String::with_capacity(2 + bytes.len() * 2);
+    output.push_str("0x");
+    for byte in bytes {
+        output.push(DIGITS[(byte >> 4) as usize] as char);
+        output.push(DIGITS[(byte & 0xf) as usize] as char);
+    }
+    output
+}
+
+fn script_a() -> Script {
+    let mut binary = ALWAYS_SUCCESS_BIN.to_vec();
+    binary[0xdc] ^= 1;
+    Script::new_builder()
+        .code_hash(packed::CellOutput::calc_data_hash(&binary))
+        .build()
+}
+
+fn script_b() -> Script {
+    Script::new_builder()
+        .code_hash(packed::Byte32::from_slice(&[0x43u8; 32]).unwrap())
+        .build()
+}
+
+struct Fixture {
+    chain: MockRunningChain,
+    script: Script,
+    a_related_height: BlockNumber,
+    a_created_height: BlockNumber,
+    a_spent_height: BlockNumber,
+    a0_outpoint: packed::OutPoint,
+    a1_outpoint: packed::OutPoint,
+    a1_capacity: ckb_types::core::Capacity,
+    tip_height: BlockNumber,
+}
+
+fn spendable_cell_dep(chain: &MockRunningChain) -> packed::CellDep {
+    let script = script_a();
+    chain
+        .shared()
+        .snapshot()
+        .get_block_by_number(0)
+        .unwrap()
+        .transactions()
+        .into_iter()
+        .filter_map(|tx| {
+            tx.outputs_data()
+                .into_iter()
+                .enumerate()
+                .find(|(_, data)| {
+                    packed::CellOutput::calc_data_hash(&data.raw_data()) == script.code_hash()
+                })
+                .map(|(idx, _)| {
+                    let out_point = packed::OutPoint::new_builder()
+                        .tx_hash(tx.hash())
+                        .index(idx as u32)
+                        .build();
+                    packed::CellDep::new_builder().out_point(out_point).build()
+                })
+        })
+        .next()
+        .expect("spendable always-success cell dep")
+}
+
+fn deterministic_timestamped_block(block: packed::Block) -> BlockView {
+    let number: u64 = block.header().raw().number().unpack();
+    block
+        .as_advanced_builder()
+        .timestamp(1_000u64 + number)
+        .build()
+}
+
+fn write_fixture_manifest(
+    chain: &MockRunningChain,
+    script: &Script,
+    a_related_height: BlockNumber,
+    a_created_height: BlockNumber,
+    a_spent_height: BlockNumber,
+    a0_outpoint: &packed::OutPoint,
+    a1_outpoint: &packed::OutPoint,
+) {
+    let snapshot = chain.shared().snapshot();
+    let blocks = (0..=TIP_HEIGHT)
+        .map(|number| {
+            let block = snapshot
+                .get_block_by_number(number)
+                .expect("fixture block stored");
+            json!({
+                "height": number,
+                "hash": format!("{:#x}", block.hash()),
+                "parent": format!("{:#x}", block.header().parent_hash()),
+                "transactions": block.transactions().len(),
+            })
+        })
+        .collect::<Vec<_>>();
+    let genesis = snapshot.get_block_by_number(0).expect("genesis stored");
+    let manifest = json!({
+        "schema_version": 1,
+        "backend": BACKEND,
+        "genesis_hash": format!("{:#x}", genesis.hash()),
+        "tip_height": TIP_HEIGHT,
+        "tip_hash": format!("{:#x}", snapshot.get_block_hash(TIP_HEIGHT).expect("tip stored")),
+        "script_a": {
+            "packed_hex": hex(script.as_slice()),
+            "script_hash": format!("{:#x}", script.calc_script_hash()),
+            "role": "lock",
+        },
+        "a_related_height": a_related_height,
+        "a_created_height": a_created_height,
+        "a_spent_height": a_spent_height,
+        "a0_outpoint": format!("{:#x}", a0_outpoint),
+        "a1_outpoint": format!("{:#x}", a1_outpoint),
+        "unmatched_interval": {"start": 1, "end": a_related_height - 1},
+        "blocks": blocks,
+        "chain_kind": "upstream MockRunningChain dummy-PoW dev fixture with runtime distinct always-success A code",
+    });
+    let path = run_root()
+        .join("fixture")
+        .join(format!("manifest-{}.json", BACKEND));
+    fs::create_dir_all(path.parent().expect("manifest parent")).expect("create manifest directory");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&manifest).expect("serialize manifest"),
+    )
+    .expect("write fixture manifest");
+    rp2_observer::emit("fixture_manifest_written", manifest, "fixture");
+}
+
+fn make_fixture() -> Fixture {
+    let script = script_a();
+    let chain = MockChain::new_with_spendable_pow("rp2a-fixture").start();
+    make_fixture_with_chain(script, chain)
+}
+
+fn make_fixture_at_path(path: &std::path::Path) -> Fixture {
+    let script = script_a();
+    let chain = MockChain::new_with_spendable_pow_at_path(path).start();
+    make_fixture_with_chain(script, chain)
+}
+
+fn make_fixture_at_persistent_paths(
+    storage_path: &std::path::Path,
+    chain_db_path: &std::path::Path,
+) -> Fixture {
+    let script = script_a();
+    let chain = MockChain::new_with_spendable_pow_at_path(storage_path)
+        .start_at_chain_db_path(chain_db_path);
+    make_fixture_with_chain(script, chain)
+}
+
+#[derive(Serialize, Deserialize)]
+struct G1FixtureMetadata {
+    script_hex: String,
+    genesis_hash: String,
+    handoff_height: BlockNumber,
+    handoff_hash: String,
+    a_related_height: BlockNumber,
+    a_created_height: BlockNumber,
+    a_spent_height: BlockNumber,
+    a0_outpoint: String,
+    a1_outpoint: String,
+    a1_capacity: u64,
+}
+
+fn g1_required_env(name: &str) -> String {
+    std::env::var(name).unwrap_or_else(|_| panic!("missing {name} environment variable"))
+}
+
+fn g1_write_output(value: Value) {
+    let path = PathBuf::from(g1_required_env("RP2C_OUTPUT"));
+    fs::create_dir_all(path.parent().expect("RP2C_OUTPUT parent")).expect("create output dir");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&value).expect("serialize G1 output"),
+    )
+    .expect("write G1 output");
+}
+
+fn g1_write_metadata(fixture: &Fixture, receipt: &AuthorityReceipt) {
+    let genesis = hex(receipt.genesis.as_slice());
+    let metadata = G1FixtureMetadata {
+        script_hex: hex(fixture.script.as_slice()),
