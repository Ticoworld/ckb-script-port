+        &mut light_client,
+        &nc,
+        peer_index,
+        metadata.handoff_height,
+    )
+    .await;
+    assert_eq!(authority.height, metadata.handoff_height);
+    let _events = start_events("g1-production-reorg", "NORMAL_FILTERED", true);
+    let result = process_rp2d_reorg(
+        &fixture,
+        light_client,
+        peers,
+        peer_index,
+        &authority,
+        "g1-production-reorg",
+    )
+    .await;
+    let state_after = service_state(fixture.chain.client_storage(), &fixture.script);
+    assert!(!has_cell_outpoint(&state_after, &fixture.a1_outpoint));
+    let replacement = result["reorg_a2_outpoint"].as_str().expect("reorg replacement");
+    let replacement_outpoint = packed::OutPoint::from_slice(
+        &decode_hex(replacement).expect("reorg replacement outpoint hex"),
+    )
+    .expect("reorg replacement outpoint");
+    assert!(has_cell_outpoint(&state_after, &replacement_outpoint));
+    let progress = fixture
+        .chain
+        .client_storage()
+        .get_filter_scripts()
+        .into_iter()
