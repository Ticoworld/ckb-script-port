+        "upstream_revision": RP2C_UPSTREAM_REVISION,
+        "handoff_height": metadata.handoff_height,
+        "fork_point": 33,
+        "fork_tip": 38,
+        "state_at_h": state_at_h,
+        "reorg_result": result,
+        "state_after": state_after,
+        "winning_branch_progress": progress,
+        "unrelated_state_preserved": true,
+        "restart_required_in_separate_process": true,
+        "destination_owned_reorg": true,
+    }));
+}
