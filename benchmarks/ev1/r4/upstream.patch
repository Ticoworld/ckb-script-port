+fn g2_write_metadata(fixture: &G2Fixture, transaction_count: usize, outputs_per_transaction: usize) {
+    let snapshot = fixture.chain.shared().snapshot();
+    let genesis_hash = snapshot.get_block_by_number(0).expect("genesis").hash();
+    let handoff_hash = snapshot
+        .get_block_hash(fixture.handoff_height)
+        .expect("handoff block");
+    let metadata = G2Metadata {
+        workload: g2_required_env("G2_WORKLOAD"),
+        handoff_height: fixture.handoff_height,
+        handoff_hash: hex(handoff_hash.as_slice()),
+        genesis_hash: hex(genesis_hash.as_slice()),
+        script_hex: hex(fixture.script.as_slice()),
+        transaction_count,
+        outputs_per_transaction,
+        matched_heights: fixture.matched_heights.clone(),
+        first_outpoint: hex(fixture.first_outpoint.as_slice()),
+        first_output_height: fixture.first_output_height,
+        first_output_capacity: fixture.first_output_capacity.as_u64(),
+    };
+    let path = PathBuf::from(g2_required_env("G2_METADATA"));
+    fs::create_dir_all(path.parent().expect("G2 metadata parent")).expect("create G2 metadata dir");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&metadata).expect("serialize G2 metadata"),
+    )
+    .expect("write G2 metadata");
+}
+
+fn g2_read_metadata() -> G2Metadata {
+    let path = PathBuf::from(g2_required_env("G2_METADATA"));
+    serde_json::from_slice(&fs::read(path).expect("read G2 metadata")).expect("decode G2 metadata")
+}
+
+fn g2_write_output(value: Value) {
+    let path = PathBuf::from(g2_required_env("G2_OUTPUT"));
+    fs::create_dir_all(path.parent().expect("G2 output parent")).expect("create G2 output dir");
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&value).expect("serialize G2 output"),
+    )
+    .expect("write G2 output");
+}
