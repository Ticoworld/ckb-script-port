+async fn rp2c_negative_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let _events = start_events(&case, "AUTHORITY_INVALID", true);
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut protocol = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(&fixture.chain, &mut protocol, &nc, peer_index, fixture.tip_height).await;
+    let before = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("before_cross_backend_negative", &before);
+    let artifact_path = PathBuf::from(rp2c_required_env("RP2C_ARTIFACT"));
+    let reason = match read_artifact(&artifact_path) {
+        Ok((_envelope, handoff, _digest)) => {
+            let authority = DestinationAuthority { genesis_hash: receipt.genesis.clone(), height: receipt.height, hash: receipt.hash.clone() };
+            fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).err().map(|err| err.to_string()).unwrap_or_else(|| "unexpectedly accepted".to_owned())
+        }
+        Err(err) => err,
+    };
+    assert_ne!(reason, "unexpectedly accepted", "cross-backend negative was accepted: {case}");
+    rp2_observer::emit("handoff_validation_rejected", json!({"case": case, "reason": reason}), "approved_validation");
+    let after = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("after_cross_backend_negative", &after);
+    assert_eq!(before, after, "negative cross-backend import mutated state");
+    assert!(fixture.chain.client_storage().get_filter_scripts().is_empty());
+    rp2_observer::emit("authority_fingerprint_unchanged", json!({"unchanged": before == after}), "independent_authority_observer");
+    rp2c_output(json!({"mode": "negative", "case": case, "process_id": rp2c_required_env("RP2C_PROCESS_ID"), "backend": BACKEND, "rejected": true, "reason": reason, "authority_unchanged": before == after, "destination_scripts_empty": true}));
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn rp2c_cross_backend_worker() {
+    setup();
+    match rp2c_required_env("RP2C_MODE").as_str() {
+        "export" => rp2c_export_worker().await,
+        "baseline" => rp2c_baseline_worker().await,
+        "import" => rp2c_import_worker().await,
+        "negative" => rp2c_negative_worker().await,
+        mode => panic!("unknown RP2C_MODE {mode}"),
+    }
+}
