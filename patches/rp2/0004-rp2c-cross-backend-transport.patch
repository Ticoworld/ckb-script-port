+async fn rp2c_export_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let (_events, receipt, handoff, state) = derive_a_for_handoff(&case, &fixture).await;
+    let valid_path = PathBuf::from(rp2c_required_env("RP2C_ARTIFACT"));
+    let artifacts = write_rp2c_artifact_variants(&handoff, &valid_path).expect("write RP2-C artifacts");
+    rp2c_output(json!({
+        "mode": "export",
+        "case": case,
+        "process_id": rp2c_required_env("RP2C_PROCESS_ID"),
+        "backend": BACKEND,
+        "upstream_revision": RP2C_UPSTREAM_REVISION,
+        "authority": authority_value(&receipt),
+        "script_hash": format!("{:#x}", handoff.script.calc_script_hash()),
+        "role": "lock",
+        "cursor": handoff.progress.cursor,
+        "handoff_height": handoff.progress.handoff_height,
+        "handoff_hash": format!("{:#x}", handoff.progress.handoff_hash),
+        "genesis_hash": format!("{:#x}", handoff.progress.genesis_hash),
+        "state_at_h": state,
+        "artifact_version": RP2C_ARTIFACT_VERSION,
+        "artifacts": artifacts,
+    }));
+}
