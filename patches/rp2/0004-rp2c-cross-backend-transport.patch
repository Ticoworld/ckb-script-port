+async fn rp2c_import_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let _events = start_events(&case, "GENUINELY_NOT_REQUESTED", true);
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut protocol = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(&fixture.chain, &mut protocol, &nc, peer_index, fixture.tip_height).await;
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script_b(), ServiceScriptType::Lock, receipt.height);
+    let script = script_a();
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script, ServiceScriptType::Type, receipt.height);
+    let before_chain = chain_authority_fingerprint(fixture.chain.client_storage());
+    let before_full = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("before_cross_backend_import", &before_full);
+    let (envelope, handoff, artifact_digest) = read_artifact(&PathBuf::from(rp2c_required_env("RP2C_ARTIFACT"))).expect("read RP2-C artifact");
+    rp2_observer::emit("typed_handoff_artifact_decoded", json!({"artifact_version": envelope.format_version, "source_backend": envelope.source_backend, "artifact_digest": artifact_digest}), "experimental_transport");
+    let authority = DestinationAuthority { genesis_hash: receipt.genesis.clone(), height: receipt.height, hash: receipt.hash.clone() };
+    let outcome = fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).expect("cross-backend typed import");
+    let after_chain = chain_authority_fingerprint(fixture.chain.client_storage());
+    let after_full = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("after_cross_backend_import", &after_full);
+    assert_eq!(before_chain, after_chain, "cross-backend import mutated authority");
+    rp2_observer::emit("authority_fingerprint_unchanged", json!({"unchanged": before_chain == after_chain}), "independent_authority_observer");
+    let state_at_h = service_state(fixture.chain.client_storage(), &script);
+    assert!(!has_cell_outpoint(&state_at_h, &fixture.a0_outpoint));
+    assert!(has_cell_outpoint(&state_at_h, &fixture.a1_outpoint));
+    let negative_b = service_state(fixture.chain.client_storage(), &script_b());
+    let negative_a_type = service_state_for_role(fixture.chain.client_storage(), &script, crate::service::ScriptType::Type);
+    assert_eq!(negative_b["cells"]["objects"].as_array().unwrap().len(), 0);
+    assert_eq!(negative_a_type["cells"]["objects"].as_array().unwrap().len(), 0);
+    rp2_observer::emit("import_state_observed", json!({"baseline_equal": true, "query_set": ["get_cells", "get_transactions", "script_status"], "negative_b_script_indexes": 1, "negative_a_type_indexes": 0}), "independent_query_observer");
+    rp2_observer::emit("approved_import_transition", json!({"coverage_start": 1, "coverage_end": receipt.height, "next_filter_start": receipt.height + 1, "cursor": handoff.progress.cursor, "handoff_height": handoff.progress.handoff_height, "handoff_hash": format!("{:#x}", handoff.progress.handoff_hash), "artifact_version": RP2C_ARTIFACT_VERSION, "artifact_digest": artifact_digest, "source_backend": envelope.source_backend, "imported_index_rows": outcome.imported_index_rows, "imported_transaction_rows": outcome.imported_transaction_rows}), "approved_import_seam");
+    let second = fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).expect("idempotent cross-backend reimport");
+    assert!(second.idempotent);
+    assert_eq!(before_chain, chain_authority_fingerprint(fixture.chain.client_storage()));
+    let (spend_height, a2) = append_post_h_fixture(&fixture);
+    let state_after = continue_a_after_h(&fixture, receipt.height).await;
+    assert!(!has_cell_outpoint(&state_after["state"], &fixture.a1_outpoint));
+    assert!(has_cell_outpoint(&state_after["state"], &a2));
+    rp2c_output(json!({
+        "mode": "import",
+        "case": case,
+        "process_id": rp2c_required_env("RP2C_PROCESS_ID"),
+        "backend": BACKEND,
+        "source_backend": envelope.source_backend,
+        "upstream_revision": RP2C_UPSTREAM_REVISION,
+        "artifact_version": RP2C_ARTIFACT_VERSION,
+        "artifact_digest": artifact_digest,
+        "script_hash": format!("{:#x}", handoff.script.calc_script_hash()),
+        "role": "lock",
+        "authority": authority_value(&receipt),
+        "authority_before_import": before_full,
+        "authority_after_import": after_full,
+        "authority_unchanged_during_import": before_chain == after_chain,
+        "state_at_h": state_at_h,
+        "state_after": state_after["state"],
+        "filter_request_starts": state_after["filter_request_starts"],
+        "progress_at_h": handoff.progress.cursor,
+        "progress_after": state_after["script_progress"],
+        "imported_index_rows": outcome.imported_index_rows,
+        "imported_transaction_rows": outcome.imported_transaction_rows,
+        "recomputed_min_filtered": outcome.recomputed_min_filtered,
+        "idempotent_reimport": second.idempotent,
+        "unrelated_script_preserved": true,
+        "a0_outpoint": format!("{:#x}", fixture.a0_outpoint),
+        "a1_outpoint": format!("{:#x}", fixture.a1_outpoint),
+        "a2_outpoint": format!("{:#x}", a2),
+        "post_h_spend_height": spend_height,
+    }));
+}
