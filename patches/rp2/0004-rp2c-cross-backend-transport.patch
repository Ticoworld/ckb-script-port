+async fn rp2c_baseline_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let (_events, receipt, handoff, state_at_h) = derive_a_for_handoff(&case, &fixture).await;
+    assert!(!has_cell_outpoint(&state_at_h, &fixture.a0_outpoint));
+    assert!(has_cell_outpoint(&state_at_h, &fixture.a1_outpoint));
+    let (spend_height, a2) = append_post_h_fixture(&fixture);
+    let state_after = continue_a_after_h(&fixture, receipt.height).await;
+    assert!(!has_cell_outpoint(&state_after["state"], &fixture.a1_outpoint));
+    assert!(has_cell_outpoint(&state_after["state"], &a2));
+    rp2c_output(json!({
+        "mode": "baseline",
+        "case": case,
+        "process_id": rp2c_required_env("RP2C_PROCESS_ID"),
+        "backend": BACKEND,
+        "upstream_revision": RP2C_UPSTREAM_REVISION,
+        "authority": authority_value(&receipt),
+        "script_hash": format!("{:#x}", handoff.script.calc_script_hash()),
+        "state_at_h": state_at_h,
+        "state_after": state_after["state"],
+        "filter_request_starts": state_after["filter_request_starts"],
+        "historical_filtering_observed": true,
+        "progress_at_h": handoff.progress.cursor,
+        "progress_after": state_after["script_progress"],
+        "a0_outpoint": format!("{:#x}", fixture.a0_outpoint),
+        "a1_outpoint": format!("{:#x}", fixture.a1_outpoint),
+        "a2_outpoint": format!("{:#x}", a2),
+        "post_h_spend_height": spend_height,
+    }));
+}
