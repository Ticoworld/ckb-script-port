+            .as_advanced_builder()
+            .timestamp(1_000u64 + 37)
+            .proposals(vec![proposal.clone()])
+            .build()
+    });
+    fixture.chain.mine_block(|block| {
+        block
+            .as_advanced_builder()
+            .timestamp(1_000u64 + 38)
+            .build()
+    });
+    fixture.chain.mine_block(|block| {
+        block
+            .as_advanced_builder()
+            .timestamp(1_000u64 + 39)
+            .transaction(tx.clone())
+            .build()
+    });
+    fixture.chain.mine_blocks(1);
