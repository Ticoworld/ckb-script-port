+async fn continue_a_after_h(fixture: &Fixture, handoff_height: BlockNumber) -> Value {
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture
+        .chain
+        .create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let authority = establish_authority(
+        &fixture.chain,
+        &mut light_client,
+        &nc,
+        peer_index,
+        fixture.chain.shared().snapshot().tip_number(),
+    )
+    .await;
+    assert!(authority.height > handoff_height);
+    let mut filter = fixture.chain.create_filter_protocol(Arc::clone(&peers));
+    let mut sync = fixture.chain.create_sync_protocol(Arc::clone(&peers));
+    let filter_nc = MockNetworkContext::new(SupportProtocols::Filter);
+    let sync_nc = MockNetworkContext::new(SupportProtocols::Sync);
+    let tip = fixture.chain.shared().snapshot().tip_number();
+    let mut filter_hashes = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_hashes_until(tip)
+        .expect("post-H filter hashes");
+    filter_hashes.remove(0);
+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes);
+    filter.notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN).await;
+    let starts = filter_request_starts(&filter_nc);
+    assert!(starts.contains(&(handoff_height + 1)), "post-H scheduler did not start at H+1: {starts:?}");
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        handoff_height + 1,
+        38,
+        tip,
+    )
+    .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        39,
+        tip,
+        tip,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        39,
+        tip,
+    )
+    .await;
+    json!({
+        "state": service_state(fixture.chain.client_storage(), &fixture.script),
+        "filter_request_starts": starts,
+        "script_progress": fixture.chain.client_storage().get_filter_scripts().into_iter()
+            .find(|ss| ss.script == fixture.script && ss.script_type == StorageScriptType::Lock)
+            .map(|ss| ss.block_number),
+    })
+}
