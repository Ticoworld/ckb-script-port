+#[tokio::test(flavor = "multi_thread")]
+async fn rp2b_typed_handoff_core() {
+    setup();
+    let source_fixture = make_fixture();
+    let (_source_events, _source_receipt, handoff, source_state) =
+        derive_a_for_handoff("rp2b-source", &source_fixture).await;
+
+    let baseline_fixture = make_fixture();
+    let (_baseline_events, _baseline_receipt, _baseline_handoff, baseline_state) =
+        derive_a_for_handoff("rp2b-baseline", &baseline_fixture).await;
+    assert_eq!(source_state, baseline_state, "source and independent baseline differ at H");
+
+    let destination_fixture = make_fixture();
+    let _destination_events = start_events("rp2b-import-destination", "GENUINELY_NOT_REQUESTED", true);
+    let peers = destination_fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = destination_fixture
+        .chain
+        .create_light_client_protocol(Arc::clone(&peers));
+    let authority_nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(
+        &destination_fixture.chain,
+        &mut light_client,
+        &authority_nc,
+        peer_index,
+        destination_fixture.tip_height,
+    )
+    .await;
+    // B is an existing, legitimate registration at the authority boundary;
+    // it remains untouched while A is imported.
+    register_script_at_through_service(
+        &destination_fixture.chain,
+        Arc::clone(&peers),
+        &script_b(),
+        ServiceScriptType::Lock,
+        receipt.height,
+    );
+    // The same packed bytes are also present under the other role.  It is a
+    // destination-owned control registration, not part of the exported A
+    // lock handoff, and it must not acquire A type indexes.
+    register_script_at_through_service(
+        &destination_fixture.chain,
+        Arc::clone(&peers),
+        &handoff.script,
+        ServiceScriptType::Type,
+        receipt.height,
+    );
+    let before_chain = chain_authority_fingerprint(destination_fixture.chain.client_storage());
+    let before_full = authority_fingerprint(destination_fixture.chain.client_storage());
+    record_fingerprint("before_typed_import", &before_full);
+    let authority = DestinationAuthority {
+        genesis_hash: receipt.genesis.clone(),
+        height: receipt.height,
+        hash: receipt.hash.clone(),
+    };
+    let outcome = destination_fixture
+        .chain
+        .client_storage()
+        .import_typed_script_handoff(&handoff, &authority)
+        .expect("valid typed import");
+    let after_chain = chain_authority_fingerprint(destination_fixture.chain.client_storage());
+    let after_full = authority_fingerprint(destination_fixture.chain.client_storage());
+    record_fingerprint("after_typed_import", &after_full);
+    assert_eq!(before_chain, after_chain, "typed import mutated chain authority");
+    rp2_observer::emit(
+        "authority_fingerprint_unchanged",
+        json!({"unchanged": before_chain == after_chain}),
+        "independent_authority_observer",
+    );
+    assert_eq!(
+        destination_fixture.chain.client_storage().get_filter_scripts().len(),
+        3,
+        "unrelated Script registration was replaced"
+    );
+    let imported_state = service_state(destination_fixture.chain.client_storage(), &handoff.script);
+    assert_eq!(baseline_state, imported_state, "query semantics differ immediately after import");
+    let negative_b = service_state(destination_fixture.chain.client_storage(), &script_b());
+    let negative_a_type = service_state_for_role(
+        destination_fixture.chain.client_storage(),
+        &handoff.script,
+        crate::service::ScriptType::Type,
+    );
+    assert_eq!(negative_b["cells"]["objects"].as_array().unwrap().len(), 0);
+    assert_eq!(negative_b["transactions_grouped"]["objects"].as_array().unwrap().len(), 0);
+    assert_eq!(negative_a_type["cells"]["objects"].as_array().unwrap().len(), 0);
+    assert_eq!(negative_a_type["transactions_grouped"]["objects"].as_array().unwrap().len(), 0);
+    assert!(destination_fixture.chain.client_storage().get_filter_scripts().iter().any(|ss| {
+        ss.script == script_b() && ss.script_type == StorageScriptType::Lock && ss.block_number == receipt.height
+    }));
+    assert!(destination_fixture.chain.client_storage().get_filter_scripts().iter().any(|ss| {
+        ss.script == handoff.script && ss.script_type == StorageScriptType::Type && ss.block_number == receipt.height
+    }), "destination A type control registration was lost");
+    assert_eq!(outcome.recomputed_min_filtered, receipt.height);
+    rp2_observer::emit(
+        "import_state_observed",
+        json!({
+            "baseline_equal": baseline_state == imported_state,
+            "query_set": ["get_cells", "get_transactions", "script_status"],
+            "negative_b_script_indexes": destination_fixture.chain.client_storage().get_filter_scripts().iter().filter(|ss| ss.script == script_b()).count(),
+            "negative_a_type_indexes": negative_a_type["cells"]["objects"].as_array().unwrap().len(),
+        }),
+        "independent_query_observer",
+    );
+    rp2_observer::emit(
+        "approved_import_transition",
+        json!({
+            "coverage_start": 1,
+            "coverage_end": receipt.height,
+            "next_filter_start": receipt.height + 1,
+            "cursor": handoff.progress.cursor,
+            "handoff_height": handoff.progress.handoff_height,
+            "handoff_hash": format!("{:#x}", handoff.progress.handoff_hash),
+            "imported_index_rows": outcome.imported_index_rows,
+            "imported_transaction_rows": outcome.imported_transaction_rows,
+        }),
+        "approved_import_seam",
+    );
+    let second = destination_fixture
+        .chain
+        .client_storage()
+        .import_typed_script_handoff(&handoff, &authority)
+        .expect("idempotent typed reimport");
+    assert!(second.idempotent);
+    assert_eq!(before_chain, chain_authority_fingerprint(destination_fixture.chain.client_storage()));
+    let after_first_full = authority_fingerprint(destination_fixture.chain.client_storage());
+    assert_eq!(after_first_full, authority_fingerprint(destination_fixture.chain.client_storage()));
+
+    append_post_h_fixture(&baseline_fixture);
+    append_post_h_fixture(&destination_fixture);
+    let baseline_after = continue_a_after_h(&baseline_fixture, receipt.height).await;
+    let destination_after = continue_a_after_h(&destination_fixture, receipt.height).await;
+    assert_eq!(baseline_after["state"], destination_after["state"], "post-H query states diverged");
+    assert_eq!(baseline_after["script_progress"], destination_after["script_progress"]);
+    assert!(destination_after["filter_request_starts"].as_array().unwrap().contains(&json!(receipt.height + 1)));
+    rp2_observer::emit(
+        "continuation_summary",
+        json!({"baseline_equal": baseline_after == destination_after, "baseline": baseline_after, "destination": destination_after}),
+        "normal_filter_scheduler",
+    );
+    write_result(
+        "rp2b-core",
+        json!({
+            "backend": BACKEND,
+            "handoff_height": receipt.height,
+            "handoff_hash": format!("{:#x}", receipt.hash),
+            "source_equals_baseline_at_h": source_state == baseline_state,
+            "import": {
+                "idempotent_reimport": second.idempotent,
+                "imported_index_rows": outcome.imported_index_rows,
+                "imported_transaction_rows": outcome.imported_transaction_rows,
+                "recomputed_min_filtered": outcome.recomputed_min_filtered,
+            },
+            "destination_equals_baseline_at_h": baseline_state == imported_state,
+            "post_h_converged": baseline_after == destination_after,
+            "destination_request_starts": destination_after["filter_request_starts"],
+            "authority_chain_unchanged": before_chain == after_chain,
+            "unrelated_script_preserved": true,
+        }),
+    );
+}
