+//! RP2-B typed Script handoff seam.
+//!
+//! This module is compiled only for the disposable RP2 test build.  It is a
+//! typed adapter over the real `LightClientStorage` key/value semantics; it is
+//! deliberately not a public package format or a general raw-KV importer.
+
+use std::collections::{HashMap, HashSet};
+
+use ckb_types::{core::BlockNumber, packed::{Byte32, Script, Transaction}, prelude::*};
+
+use crate::storage::{
+    extract_raw_data, BatchWriter, IteratorDirection, IteratorStart, Key, KeyPrefix,
+    LightClientStorage, ScriptStatus, ScriptType, StorageBackend,
+};
+
+pub const HANDOFF_FORMAT_VERSION: u32 = 1;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum HandoffRole {
+    Lock,
+    Type,
+}
+
+impl HandoffRole {
+    fn script_type(self) -> ScriptType {
+        match self {
+            Self::Lock => ScriptType::Lock,
+            Self::Type => ScriptType::Type,
+        }
+    }
+
+    fn index_prefix(self) -> u8 {
+        match self {
+            Self::Lock => KeyPrefix::CellLockScript as u8,
+            Self::Type => KeyPrefix::CellTypeScript as u8,
+        }
+    }
+
+    fn transaction_prefix(self) -> u8 {
+        match self {
+            Self::Lock => KeyPrefix::TxLockScript as u8,
+            Self::Type => KeyPrefix::TxTypeScript as u8,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HandoffRow {
+    pub key: Vec<u8>,
+    pub value: Vec<u8>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ScriptDerivedState {
+    pub index_rows: Vec<HandoffRow>,
+    pub transaction_index_rows: Vec<HandoffRow>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HistoricalClosure {
+    /// Transaction rows needed by the Script indexes and by future spends.
+    pub transaction_rows: Vec<HandoffRow>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ScriptProgress {
+    pub cursor: BlockNumber,
+    pub handoff_height: BlockNumber,
+    pub handoff_hash: Byte32,
+    pub genesis_hash: Byte32,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TypedScriptHandoff {
+    pub format_version: u32,
+    pub script: Script,
+    pub role: HandoffRole,
+    pub state: ScriptDerivedState,
+    pub closure: HistoricalClosure,
+    pub progress: ScriptProgress,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DestinationAuthority {
+    pub genesis_hash: Byte32,
+    pub height: BlockNumber,
+    pub hash: Byte32,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ImportOutcome {
+    pub idempotent: bool,
+    pub imported_index_rows: usize,
+    pub imported_transaction_rows: usize,
+    pub recomputed_min_filtered: BlockNumber,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HandoffError {
+    Invalid(String),
+    Storage(String),
+}
+
+impl std::fmt::Display for HandoffError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Invalid(s) | Self::Storage(s) => f.write_str(s),
+        }
+    }
+}
+
+impl std::error::Error for HandoffError {}
+
+fn collect_prefix<S: StorageBackend>(storage: &S, prefix: Vec<u8>) -> Vec<HandoffRow> {
+    let end = prefix.clone();
+    storage
+        .collect_iterator(
+            IteratorStart::From(prefix),
+            IteratorDirection::Forward,
+            Box::new(move |key| key.starts_with(&end)),
+            Box::new(|_key, value| Some(value.to_vec())),
+            usize::MAX,
+        )
+        .into_iter()
+        .map(|kv| HandoffRow { key: kv.key, value: kv.value })
+        .collect()
+}
+
+fn read<S: StorageBackend>(storage: &S, key: Vec<u8>) -> Result<Vec<u8>, HandoffError> {
+    storage
+        .get(key)
+        .map_err(|e| HandoffError::Storage(e.to_string()))?
+        .ok_or_else(|| HandoffError::Invalid("required row is missing".to_owned()))
+}
+
+fn script_key_prefix(script: &Script, _role: HandoffRole, prefix: u8) -> Vec<u8> {
+    let mut key = vec![prefix];
+    key.extend_from_slice(&extract_raw_data(script));
+    key
+}
+
+fn registration_key(script: &Script, role: HandoffRole) -> Vec<u8> {
+    let mut key = Key::Meta("FILTER_SCRIPTS").into_vec();
+    key.extend_from_slice(script.as_slice());
+    key.push(match role { HandoffRole::Lock => 0, HandoffRole::Type => 1 });
+    key
+}
+
+fn validate_transaction_row(row: &HandoffRow) -> Result<Byte32, HandoffError> {
+    if row.key.len() != 33 || row.key[0] != KeyPrefix::TxHash as u8 {
+        return Err(HandoffError::Invalid("closure contains a non-TxHash row".to_owned()));
+    }
+    if row.value.len() < 12 {
+        return Err(HandoffError::Invalid("transaction row is truncated".to_owned()));
+    }
+    Transaction::from_slice(&row.value[12..])
+        .map_err(|_| HandoffError::Invalid("closure contains invalid packed transaction".to_owned()))?;
+    Byte32::from_slice(&row.key[1..]).map_err(|_| HandoffError::Invalid("invalid TxHash key".to_owned()))
+}
+
+fn validate_index_row(row: &HandoffRow, script: &Script, role: HandoffRole) -> Result<Byte32, HandoffError> {
+    let raw = extract_raw_data(script);
+    let expected_prefix = if row.key.first() == Some(&role.index_prefix()) {
+        role.index_prefix()
+    } else if row.key.first() == Some(&role.transaction_prefix()) {
+        role.transaction_prefix()
+    } else {
+        return Err(HandoffError::Invalid("state row has wrong Script role prefix".to_owned()));
+    };
+    let suffix_len = if expected_prefix == role.index_prefix() { 16 } else { 17 };
+    if row.key.len() != 1 + raw.len() + suffix_len || !row.key[1..1 + raw.len()].eq(raw.as_slice()) {
+        return Err(HandoffError::Invalid("state row is not bound to the exact packed Script".to_owned()));
+    }
+    if row.value.len() != 32 {
+        return Err(HandoffError::Invalid("state row value is not a transaction hash".to_owned()));
+    }
+    Byte32::from_slice(&row.value).map_err(|_| HandoffError::Invalid("invalid state TxHash".to_owned()))
+}
+
+fn all_rows_unique(rows: impl Iterator<Item = HandoffRow>) -> Result<Vec<HandoffRow>, HandoffError> {
+    let mut seen = HashSet::new();
+    let mut output = Vec::new();
+    for row in rows {
+        if !seen.insert(row.key.clone()) {
+            return Err(HandoffError::Invalid("duplicate handoff key".to_owned()));
+        }
+        output.push(row);
+    }
+    Ok(output)
+}
+
+pub trait TypedScriptHandoffStorage: LightClientStorage {
+    /// Export exact Script-role index rows and the minimum transaction closure.
+    fn export_typed_script_handoff(
+        &self,
+        script: Script,
+        role: HandoffRole,
+        handoff_height: BlockNumber,
+    ) -> Result<TypedScriptHandoff, HandoffError>
+    where
+        Self: Sized,
+    {
+        let script_type = role.script_type();
+        let status = self
+            .get_filter_scripts()
+            .into_iter()
+            .find(|ss| ss.script == script && ss.script_type == script_type)
+            .ok_or_else(|| HandoffError::Invalid("Script/role is not registered".to_owned()))?;
+        if status.block_number > handoff_height {
+            return Err(HandoffError::Invalid("source cursor exceeds handoff height".to_owned()));
+        }
+        // The accepted authority tip is stored as LAST_STATE even when the
+        // block had no Script match.  Prefer that chain-bound fact at the tip;
+        // older handoff boundaries must already have a real block-number row.
+        let tip = self.get_tip_header();
+        let tip_number: BlockNumber = tip.raw().number().unpack();
+        let handoff_hash = if tip_number == handoff_height {
+            tip.calc_header_hash()
+        } else {
+            self.get_block_hash(handoff_height).ok_or_else(|| {
+                HandoffError::Invalid("source handoff block is unavailable".to_owned())
+            })?
+        };
+        let genesis_hash = self.get_genesis_block().calc_header_hash();
+
+        let index_rows = collect_prefix(self, script_key_prefix(&script, role, role.index_prefix()));
+        let transaction_index_rows = collect_prefix(self, script_key_prefix(&script, role, role.transaction_prefix()));
+        let mut tx_hashes = HashSet::new();
+        for row in index_rows.iter().chain(transaction_index_rows.iter()) {
+            tx_hashes.insert(validate_index_row(row, &script, role)?);
+        }
+        let mut transaction_rows = Vec::with_capacity(tx_hashes.len());
+        for tx_hash in tx_hashes {
+            let key = Key::TxHash(&tx_hash).into_vec();
+            let value = read(self, key.clone())?;
+            let row = HandoffRow { key, value };
+            validate_transaction_row(&row)?;
+            transaction_rows.push(row);
+        }
+        transaction_rows.sort_by(|a, b| a.key.cmp(&b.key));
+        Ok(TypedScriptHandoff {
+            format_version: HANDOFF_FORMAT_VERSION,
+            script,
+            role,
+            state: ScriptDerivedState { index_rows, transaction_index_rows },
+            closure: HistoricalClosure { transaction_rows },
+            progress: ScriptProgress {
+                cursor: status.block_number,
+                handoff_height,
+                handoff_hash,
+                genesis_hash,
+            },
+        })
+    }
+
+    /// Validate and atomically install a typed handoff without writing C/R rows.
+    fn import_typed_script_handoff(
+        &self,
+        handoff: &TypedScriptHandoff,
+        authority: &DestinationAuthority,
+    ) -> Result<ImportOutcome, HandoffError>
+    where
+        Self: Sized,
+    {
+        if handoff.format_version != HANDOFF_FORMAT_VERSION {
+            return Err(HandoffError::Invalid("unsupported handoff format version".to_owned()));
+        }
+        if handoff.progress.genesis_hash != authority.genesis_hash {
+            return Err(HandoffError::Invalid("genesis mismatch".to_owned()));
+        }
+        if handoff.progress.handoff_height != authority.height
+            || handoff.progress.handoff_hash != authority.hash
+            || handoff.progress.cursor > authority.height
+        {
+            return Err(HandoffError::Invalid("handoff identity does not match destination authority".to_owned()));
+        }
+        let stored_genesis = self.get_genesis_block().calc_header_hash();
+        if stored_genesis != authority.genesis_hash {
+            return Err(HandoffError::Invalid("destination genesis mismatch".to_owned()));
+        }
+        let tip = self.get_tip_header();
+        let tip_number: BlockNumber = tip.raw().number().unpack();
+        if tip_number != authority.height || tip.calc_header_hash() != authority.hash {
+            return Err(HandoffError::Invalid("destination tip is not independently verified".to_owned()));
+        }
+
+        let state_rows = all_rows_unique(
+            handoff
+                .state
+                .index_rows
+                .iter()
+                .chain(handoff.state.transaction_index_rows.iter())
+                .cloned(),
+        )?;
+        let closure_rows = all_rows_unique(handoff.closure.transaction_rows.iter().cloned())?;
+        let mut referenced = HashSet::new();
+        for row in &state_rows {
+            referenced.insert(validate_index_row(row, &handoff.script, handoff.role)?);
+        }
+        let mut closure = HashMap::new();
+        for row in &closure_rows {
+            let hash = validate_transaction_row(row)?;
+            closure.insert(hash, row);
+        }
+        if referenced.iter().any(|hash| !closure.contains_key(hash)) {
+            return Err(HandoffError::Invalid("Script index references missing transaction closure".to_owned()));
+        }
+        if state_rows.iter().chain(closure_rows.iter()).any(|row| row.key.first().is_some_and(|p| *p >= KeyPrefix::BlockHash as u8)) {
+            return Err(HandoffError::Invalid("handoff attempts to import chain authority state".to_owned()));
+        }
+
+        let reg_key = registration_key(&handoff.script, handoff.role);
+        let existing_status = self
+            .get_filter_scripts()
+            .into_iter()
+            .find(|ss| ss.script == handoff.script && ss.script_type == handoff.role.script_type());
+        if let Some(status) = existing_status.as_ref() {
+            if status.block_number > handoff.progress.cursor {
+                return Err(HandoffError::Invalid("handoff would regress Script progress".to_owned()));
+            }
+        }
+        for row in state_rows.iter().chain(closure_rows.iter()) {
+            if let Some(existing) = self
+                .get(row.key.clone())
+                .map_err(|e| HandoffError::Storage(e.to_string()))?
+            {
+                if existing != row.value {
+                    return Err(HandoffError::Invalid("destination row conflicts with handoff".to_owned()));
+                }
+            }
+        }
+
+        let mut scripts = self.get_filter_scripts();
+        if let Some(status) = scripts.iter_mut().find(|ss| ss.script == handoff.script && ss.script_type == handoff.role.script_type()) {
+            if status.block_number < handoff.progress.cursor {
+                status.block_number = handoff.progress.cursor;
+            }
+        } else {
+            scripts.push(ScriptStatus {
+                script: handoff.script.clone(),
+                script_type: handoff.role.script_type(),
+                block_number: handoff.progress.cursor,
+            });
+        }
+        let recomputed_min = scripts.iter().map(|ss| ss.block_number).min().unwrap_or_default();
+
+        // Every approved S/H/P write, including the shared global minimum, is
+        // one real backend batch.  No C rows (prefixes 160+) are included.
+        let mut batch = self.batch();
+        for row in state_rows.iter().chain(closure_rows.iter()) {
+            batch.put(&row.key, &row.value);
+        }
+        batch.put(&reg_key, &handoff.progress.cursor.to_be_bytes());
+        batch.put(
+            &Key::Meta("MIN_FILTERED_NUMBER").into_vec(),
+            &recomputed_min.to_le_bytes(),
+        );
+        batch.commit().map_err(|e| HandoffError::Storage(e.to_string()))?;
+
+        Ok(ImportOutcome {
+            idempotent: existing_status.is_some(),
+            imported_index_rows: handoff.state.index_rows.len(),
+            imported_transaction_rows: handoff.state.transaction_index_rows.len(),
+            recomputed_min_filtered: recomputed_min,
+        })
+    }
+}
+
+impl<S: LightClientStorage> TypedScriptHandoffStorage for S {}
