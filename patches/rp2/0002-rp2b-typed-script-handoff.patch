+fn register_script_at_through_service(
+    chain: &MockRunningChain,
+    peers: Arc<crate::protocols::Peers>,
+    script: &Script,
+    script_type: ServiceScriptType,
+    block_number: BlockNumber,
+) {
+    let pending_txs = Arc::new(std::sync::RwLock::new(PendingTxs::default()));
+    let swc = StorageWithChainData::new(chain.client_storage().clone(), peers, pending_txs);
+    let service = LightClientChainService::new(swc, Arc::new(chain.consensus().clone()));
+    service.set_scripts(
+        vec![ServiceScriptStatus {
+            script: script.clone().into(),
+            script_type,
+            block_number: block_number.into(),
+        }],
+        Some(ServiceSetScriptsCommand::Partial),
+    );
+}
+
+fn service_state_for_role(
+    storage: &Storage,
+    script: &Script,
+    query_script_type: crate::service::ScriptType,
+) -> Value {
+    use crate::service::{LightClientService, Order, SearchKey};
+    let service = LightClientService::new(Arc::new(storage.clone()));
+    let is_lock = matches!(query_script_type, crate::service::ScriptType::Lock);
+    let search = || SearchKey {
+        script: script.clone().into(),
+        script_type: if is_lock {
+            crate::service::ScriptType::Lock
+        } else {
+            crate::service::ScriptType::Type
+        },
+        filter: None,
+        with_data: Some(true),
+        group_by_transaction: None,
+    };
+    let cells = service
+        .get_cells(search(), Order::Asc, 100.into(), None)
+        .expect("get_cells");
+    let mut grouped = search();
+    grouped.group_by_transaction = Some(true);
+    let txs_grouped = service
+        .get_transactions(grouped, Order::Asc, 100.into(), None)
+        .expect("get_transactions grouped");
+    let txs_ungrouped = service
+        .get_transactions(search(), Order::Asc, 100.into(), None)
+        .expect("get_transactions ungrouped");
+    json!({
+        "cells": serde_json::to_value(cells).expect("serialize cells"),
+        "transactions_grouped": serde_json::to_value(txs_grouped).expect("serialize grouped txs"),
+        "transactions_ungrouped": serde_json::to_value(txs_ungrouped).expect("serialize txs"),
+        "script_progress": storage.get_filter_scripts().into_iter()
+            .filter(|ss| ss.script == *script && ss.script_type == StorageScriptType::Lock)
+            .map(|ss| ss.block_number).next(),
+    })
+}
+
+fn service_state(storage: &Storage, script: &Script) -> Value {
+    service_state_for_role(storage, script, crate::service::ScriptType::Lock)
+}
+
+fn chain_authority_fingerprint(storage: &Storage) -> Value {
+    let rows = storage
+        .collect_iterator(
+            IteratorStart::From(Vec::new()),
+            IteratorDirection::Forward,
+            Box::new(|_| true),
+            Box::new(|_key, value| Some(value.to_vec())),
+            usize::MAX,
+        )
+        .into_iter()
+        .filter(|row| {
+            if row.key.first().is_none_or(|prefix| *prefix < 160) {
+                return false;
+            }
+            if row.key.first() == Some(&224) {
+                let meta = &row.key[1..];
+                return meta != b"MIN_FILTERED_NUMBER"
+                    && !meta.starts_with(b"FILTER_SCRIPTS")
+                    && !meta.starts_with(b"MATCHED_BLOCKS");
+            }
+            true
+        })
+        .map(|row| json!({"key": hex(&row.key), "value": hex(&row.value)}))
+        .collect::<Vec<_>>();
+    json!({"authority_rows": rows})
+}
