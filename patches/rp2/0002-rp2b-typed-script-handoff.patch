+#[tokio::test(flavor = "multi_thread")]
+async fn rp2b_real_import_adversaries_reject_closed() {
+    setup();
+    let source_fixture = make_fixture();
+    let (_source_events, _source_receipt, valid_handoff, _source_state) =
+        derive_a_for_handoff("rp2b-adversary-source", &source_fixture).await;
+    let fixture = make_fixture();
+    let _events = start_events("rp2b-import-adversarial", "AUTHORITY_INVALID", true);
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut protocol = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(&fixture.chain, &mut protocol, &nc, peer_index, fixture.tip_height).await;
+    let before = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("before_real_import_adversaries", &before);
+    let authority = DestinationAuthority {
+        genesis_hash: receipt.genesis.clone(),
+        height: receipt.height,
+        hash: receipt.hash.clone(),
+    };
+    let mut cases: Vec<(&str, crate::rp2_handoff::TypedScriptHandoff)> = Vec::new();
+    let mut wrong_hash = valid_handoff.clone();
+    wrong_hash.progress.handoff_hash = packed::Byte32::from_slice(&[1u8; 32]).unwrap();
+    cases.push(("wrong_handoff_hash", wrong_hash));
+    let mut wrong_genesis = valid_handoff.clone();
+    wrong_genesis.progress.genesis_hash = packed::Byte32::from_slice(&[2u8; 32]).unwrap();
+    cases.push(("wrong_genesis", wrong_genesis));
+    let mut wrong_script = valid_handoff.clone();
+    wrong_script.script = script_b();
+    cases.push(("wrong_script", wrong_script));
+    let mut wrong_role = valid_handoff.clone();
+    wrong_role.role = HandoffRole::Type;
+    cases.push(("wrong_role", wrong_role));
+    let mut beyond = valid_handoff.clone();
+    beyond.progress.cursor = receipt.height + 1;
+    cases.push(("cursor_beyond_verified", beyond));
+    let mut stale_version = valid_handoff.clone();
+    stale_version.format_version = 99;
+    cases.push(("stale_format", stale_version));
+    let mut forged_c = valid_handoff.clone();
+    forged_c.closure.transaction_rows.push(HandoffRow { key: vec![160u8; 33], value: vec![] });
+    cases.push(("forged_chain_closure", forged_c));
+    for (name, claim) in cases {
+        let result = fixture
+            .chain
+            .client_storage()
+            .import_typed_script_handoff(&claim, &authority);
+        assert!(result.is_err(), "malicious handoff unexpectedly accepted: {name}");
+        let reason = result.err().map(|e| e.to_string()).unwrap_or_else(|| "accepted".to_owned());
+        rp2_observer::emit(
+            "handoff_validation_rejected",
+            json!({"case": name, "reason": reason}),
+            "approved_validation",
+        );
+    }
+    let after = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("after_real_import_adversaries", &after);
+    assert_eq!(before, after, "rejected imports changed destination authority/state");
+    assert!(fixture.chain.client_storage().get_filter_scripts().is_empty());
+    rp2_observer::emit("authority_fingerprint_unchanged", json!({"unchanged": true}), "independent_authority_observer");
+    write_result(
+        "rp2b-adversarial",
+        json!({
+            "backend": BACKEND,
+            "rejected_cases": [
+                "wrong_handoff_hash",
+                "wrong_genesis",
+                "wrong_script",
+                "wrong_role",
+                "cursor_beyond_verified",
+                "stale_format",
+                "forged_chain_closure",
+            ],
+            "authority_unchanged": before == after,
+            "destination_scripts_empty": fixture.chain.client_storage().get_filter_scripts().is_empty(),
+        }),
+    );
+}
