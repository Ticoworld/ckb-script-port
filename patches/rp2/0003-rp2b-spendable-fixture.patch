+fn spend_attempt(
+    fixture: &Fixture,
+    outpoint: packed::OutPoint,
+    include_cell_dep: bool,
+    lock: Script,
+) -> Result<(), String> {
+    let output = packed::CellOutput::new_builder()
+        .capacity(fixture.a1_capacity.safe_sub(1000u32).unwrap().pack())
+        .lock(lock)
+        .build();
+    let mut builder = TransactionView::new_advanced_builder()
+        .input(packed::CellInput::new(outpoint, 0))
+        .output(output)
+        .output_data(packed::Bytes::default());
+    if include_cell_dep {
+        builder = builder.cell_dep(spendable_cell_dep(&fixture.chain));
+    }
+    fixture
+        .chain
+        .tx_pool()
+        .test_accept_tx(builder.build())
+        .map_err(|err| err.to_string())?
+        .map(|_| ())
+        .map_err(|err| err.to_string())
+}
+
+#[test]
+fn rp2b_spend_adversaries_reject_closed() {
+    setup();
+    let fixture = make_fixture();
+    let tip_before = fixture.chain.shared().snapshot().tip_number();
+
+    // SPEND-NEG-1: omitting the executable A cell dependency must fail at the
+    // real transaction-pool validation boundary.
+    let missing_dep = spend_attempt(
+        &fixture,
+        fixture.a1_outpoint.clone(),
+        false,
+        fixture.script.clone(),
+    );
+    assert!(missing_dep.is_err(), "spend without A code dep was accepted");
+
+    // SPEND-NEG-2: a different/non-live outpoint cannot be claimed as the
+    // imported A1 lifecycle transition.
+    let wrong_outpoint = spend_attempt(
+        &fixture,
+        fixture.a0_outpoint.clone(),
+        true,
+        fixture.script.clone(),
+    );
+    assert!(wrong_outpoint.is_err(), "spent A0 outpoint was accepted");
+
+    // SPEND-NEG-3: a replacement locked by B is not an A replacement.  The
+    // transaction may be structurally valid (the output lock is not executed
+    // while consuming A1), but it is never accepted as A lifecycle state.
+    let wrong_role = spend_attempt(
+        &fixture,
+        fixture.a1_outpoint.clone(),
+        true,
+        script_b(),
+    );
+    assert_ne!(script_b(), fixture.script);
+    assert_eq!(tip_before, fixture.chain.shared().snapshot().tip_number());
+    write_result(
+        "rp2b-spend-adversarial",
+        json!({
+            "backend": BACKEND,
+            "spend_neg_1_missing_cell_dep": {"rejected": missing_dep.is_err(), "reason": missing_dep.err().unwrap_or_default()},
+            "spend_neg_2_wrong_outpoint": {"rejected": wrong_outpoint.is_err(), "reason": wrong_outpoint.err().unwrap_or_default()},
+            "spend_neg_3_wrong_role_not_a_replacement": {"output_role_is_a": false, "submission": if wrong_role.is_ok() { "accepted-but-not-A" } else { "rejected" }, "reason": wrong_role.err().unwrap_or_default()},
+            "chain_tip_unchanged": true,
+        }),
+    );
+}
