+    /// Build the disposable RP2 fixture with a second, genuinely executable
+    /// always-success cell. The ELF differs only in its non-loadable
+    /// `.comment` section, so it has a distinct code hash while retaining the
+    /// canonical upstream always-success execution semantics.
+    pub(crate) fn new_with_spendable_pow(prefix: &str) -> Self {
+        let temp_dir = tempfile::Builder::new()
+            .prefix("rp2b-spendable-spec")
+            .tempdir()
+            .unwrap();
+        let binary_path = temp_dir.path().join("always_success_distinct");
+        let mut binary = ALWAYS_SUCCESS_BIN.to_vec();
+        binary[0xdc] ^= 1;
+        fs::write(&binary_path, binary).unwrap();
+        let cells_dir = temp_dir.path().join("cells");
+        fs::create_dir_all(&cells_dir).unwrap();
+        fs::write(cells_dir.join("always_success"), ALWAYS_SUCCESS_BIN).unwrap();
+
+        let config = include_str!("../specs/dummy_pow.toml");
+        let binary_path = binary_path
+            .to_string_lossy()
+            .replace('\\', "/");
+        let config = config.replace(
+            "[genesis.system_cells_lock]",
+            &format!(
+                "[[genesis.system_cells]]\nfile = {{ file = \"{binary_path}\" }}\ncreate_type_id = false\n\n[genesis.system_cells_lock]"
+            ),
+        );
+        assert!(config.contains("cells/always_success\""));
+        let config_path: PathBuf = temp_dir.path().join("dummy_pow_spendable.toml");
+        fs::write(&config_path, config).unwrap();
+        let resource = Resource::file_system(config_path.to_str().unwrap().into());
+        Self::new(&resource, prefix)
+    }
