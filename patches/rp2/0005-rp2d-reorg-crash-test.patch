+async fn rp2d_crash_import_worker() {
+    let db_path = PathBuf::from(rp2d_required_env("RP2D_DB_PATH"));
+    let fixture = make_fixture_at_path(&db_path);
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(&fixture.chain, &mut light_client, &nc, peer_index, fixture.tip_height).await;
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script_b(), ServiceScriptType::Lock, receipt.height);
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script_a(), ServiceScriptType::Type, receipt.height);
+    if let Ok(path) = std::env::var("RP2D_AUTHORITY_BEFORE") {
+        fs::write(path, serde_json::to_vec(&chain_authority_fingerprint(fixture.chain.client_storage())).expect("serialize authority fingerprint")).expect("write authority-before fingerprint");
+    }
+    // C0 is deliberately outside the handoff function: artifact open/decode
+    // is an orchestration boundary and must not be confused with validation.
+    if std::env::var("RP2D_CRASH_STAGE").ok().as_deref() == Some("C0") {
+        std::process::abort();
+    }
+    let (_envelope, handoff, digest) = read_artifact(&PathBuf::from(rp2d_required_env("RP2C_ARTIFACT"))).expect("read crash artifact");
+    let authority = DestinationAuthority { genesis_hash: receipt.genesis, height: receipt.height, hash: receipt.hash };
+    // The importer contains test-only process-abort points C0..C9.  A
+    // deliberate abort is required here; returning an error would not test
+    // the backend's crash/reopen behavior.
+    fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).expect("crash worker import reached failpoint");
+    rp2c_output(json!({"mode": "crash-import-unexpectedly-completed", "backend": BACKEND, "artifact_digest": digest}));
+}
