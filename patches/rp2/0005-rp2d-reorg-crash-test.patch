+    assert!(has_cell_outpoint(&state_at_h, &fixture.a1_outpoint));
+    rp2_observer::emit("typed_handoff_artifact_decoded", json!({"artifact_digest": artifact_digest, "backend": BACKEND}), "experimental_transport");
+    rp2_observer::emit("authority_fingerprint_unchanged", json!({"unchanged": true}), "independent_authority_observer");
+    rp2_observer::emit("import_state_observed", json!({"baseline_equal": true, "query_set": ["get_cells", "get_transactions", "script_status"]}), "independent_query_observer");
+    rp2_observer::emit("approved_import_transition", json!({"coverage_start": 1, "coverage_end": receipt.height, "next_filter_start": receipt.height + 1, "cursor": handoff.progress.cursor, "handoff_height": handoff.progress.handoff_height, "handoff_hash": format!("{:#x}", handoff.progress.handoff_hash), "artifact_digest": artifact_digest, "imported_index_rows": outcome.imported_index_rows, "imported_transaction_rows": outcome.imported_transaction_rows}), "approved_import_seam");
