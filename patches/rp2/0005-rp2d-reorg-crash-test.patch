+    let outcome = fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).expect("typed reorg handoff");
+    let after_chain = chain_authority_fingerprint(fixture.chain.client_storage());
+    let after_full = authority_fingerprint(fixture.chain.client_storage());
+    assert_eq!(before_chain, after_chain, "reorg handoff mutated authority");
