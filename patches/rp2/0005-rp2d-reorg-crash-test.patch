+// RP2-D reorg worker.  The destination first owns a typed A handoff at the
+// old main-chain tip (36), then a separate remote fixture is rewound to the
+// common block 33 and extended with a strictly longer fork.  Only the normal
+// LightClientProtocol proof path is allowed to select the fork and invoke the
+// storage rollback; this test never calls Storage::rollback_to_block directly.
+fn append_rp2d_reorg_branch(fixture: &Fixture) -> (BlockNumber, packed::OutPoint) {
+    const FORK_POINT: BlockNumber = 33;
+    const NEW_TIP: BlockNumber = 38;
+    fixture.chain.rollback_to(FORK_POINT, Default::default());
+    assert_eq!(fixture.chain.shared().snapshot().tip_number(), FORK_POINT);
+    // The upstream controller deliberately requeues detached transactions
+    // during a reorg.  Clear that remote-fork tx-pool entry before mining the
+    // alternate branch so the old A1 transaction cannot be reintroduced by
+    // the fixture itself.
+    fixture
+        .chain
+        .tx_pool()
+        .clear_pool(Arc::clone(&*fixture.chain.shared().snapshot()))
+        .expect("clear detached remote transactions");
+
+    // The old branch consumed A0 at block 34.  The replacement fork creates
+    // a distinct A2R from a valid fork-branch cellbase input; this avoids
+    // relying on a detached transaction pool entry while still requiring the
+    // protocol rollback to remove the old A1 index and discover new history.
+    let txbase = fixture.chain.get_cellbase_as_input(FORK_POINT);
+    let input = txbase.inputs().get(0).expect("fork cellbase input").to_owned();
+    let cellbase_dep = txbase
+        .cell_deps()
+        .get(0)
+        .expect("fork cellbase dependency")
+        .to_owned();
+    let input_capacity: ckb_types::core::Capacity = txbase
+        .output(0)
+        .expect("fork cellbase output")
+        .capacity()
+        .unpack();
+    let output = packed::CellOutput::new_builder()
+        .capacity(input_capacity.safe_sub(500u32).unwrap().pack())
+        .lock(fixture.script.clone())
+        .build();
+    let tx = TransactionView::new_advanced_builder()
+        .cell_dep(cellbase_dep)
+        .cell_dep(spendable_cell_dep(&fixture.chain))
+        .header_dep(
+            fixture
+                .chain
+                .shared()
+                .snapshot()
+                .get_block_hash(fixture.a_created_height)
+                .unwrap(),
+        )
+        .input(input)
+        .output(output)
+        .output_data(packed::Bytes::default())
+        .build();
+    let proposal = tx.proposal_short_id();
+    fixture.chain.mine_block(|block| {
+        let number: u64 = block.header().raw().number().unpack();
+        block
+            .as_advanced_builder()
+            .timestamp(2_000u64 + number)
+            .proposals(vec![proposal.clone()])
+            .build()
+    });
+    fixture.chain.mine_block(|block| {
+        let number: u64 = block.header().raw().number().unpack();
+        block
+            .as_advanced_builder()
+            .timestamp(2_000u64 + number)
+            .build()
+    });
+    fixture.chain.mine_block(|block| {
+        let number: u64 = block.header().raw().number().unpack();
+        block
+            .as_advanced_builder()
+            .timestamp(2_000u64 + number)
+            .transaction(tx.clone())
+            .build()
+    });
+    for _ in 37..=NEW_TIP {
+        fixture.chain.mine_block(deterministic_timestamped_block);
+    }
+    assert_eq!(fixture.chain.shared().snapshot().tip_number(), NEW_TIP);
+    (NEW_TIP, packed::OutPoint::new(tx.hash(), 0))
+}
