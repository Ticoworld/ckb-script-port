+async fn process_rp2d_reorg(
+    fixture: &Fixture,
+    mut light_client: LightClientProtocol,
+    peers: Arc<crate::protocols::Peers>,
+    peer_index: PeerIndex,
+    authority: &AuthorityReceipt,
+    case: &str,
+) -> Value {
+    let (fork_tip, reorg_a2) = append_rp2d_reorg_branch(fixture);
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let prove_request = fixture.chain.build_prove_request(
+        authority.height,
+        fork_tip,
+        &[],
+        fork_tip - LAST_N_BLOCKS + 1,
+        LAST_N_BLOCKS,
+    );
+    let last_state = LastState::new(prove_request.get_last_header().to_owned());
+    peers
+        .update_last_state(peer_index, last_state)
+        .expect("update fork last state");
+    peers
+        .update_prove_request(peer_index, prove_request)
+        .expect("update fork prove request");
+    let message = rp2d_reorg_headers_and_proof(fixture, authority.height, fork_tip, LAST_N_BLOCKS);
+    light_client.received(nc.context(), peer_index, message.as_bytes()).await;
+    assert!(nc.not_banned(peer_index), "real fork proof was rejected");
+    let prove_state = light_client
+        .get_peer_state(&peer_index)
+        .expect("fork peer state")
+        .get_prove_state()
+        .expect("fork prove state")
+        .to_owned();
+    let fork_header: ckb_types::packed::VerifiableHeader = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_verifiable_header_by_number(fork_tip)
+        .unwrap();
+    let fork_header: VerifiableHeader = fork_header.into();
+    assert!(prove_state.is_same_as(&fork_header));
+    let reorg_event = json!({
+        "case": case,
+        "old_tip": authority.height,
+        "fork_point": 33,
+        "new_tip": fork_tip,
+        "reorg_last_headers": prove_state.get_reorg_last_headers().iter().map(|h| h.number()).collect::<Vec<_>>(),
+        "storage_min_filtered_after_rollback": fixture.chain.client_storage().get_min_filtered_block_number(),
+    });
+    rp2_observer::emit("reorg_selected_by_protocol", reorg_event, "normal_chain_proof");
+    rp2_observer::emit(
+        "reorg_state_after_rollback",
+        json!({
+            "old_a1_present": has_cell_outpoint(&service_state(fixture.chain.client_storage(), &fixture.script), &fixture.a1_outpoint),
+            "script_index_rows": raw_script_index_count(fixture.chain.client_storage(), &fixture.script),
+            "min_filtered": fixture.chain.client_storage().get_min_filtered_block_number(),
+        }),
+        "normal_chain_proof",
+    );
+
+    let mut filter = fixture.chain.create_filter_protocol(Arc::clone(&peers));
+    let mut sync = fixture.chain.create_sync_protocol(Arc::clone(&peers));
+    let filter_nc = MockNetworkContext::new(SupportProtocols::Filter);
+    let sync_nc = MockNetworkContext::new(SupportProtocols::Sync);
+    let mut filter_hashes = fixture
+        .chain
+        .shared()
+        .snapshot()
+        .get_block_filter_hashes_until(fork_tip)
+        .expect("fork filter hashes");
+    filter_hashes.remove(0);
+    peers.mock_latest_block_filter_hashes(peer_index, 0, filter_hashes);
+    filter.notify(filter_nc.context(), GET_BLOCK_FILTERS_TOKEN).await;
+    let starts = filter_request_starts(&filter_nc);
+    assert!(starts.iter().any(|start| *start == 34), "fork filtering did not restart at 34: {starts:?}");
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        34,
+        35,
+        fork_tip,
+    )
+    .await;
+    feed_filter_range(
+        &fixture.chain,
+        &mut filter,
+        &peers,
+        &filter_nc,
+        peer_index,
+        36,
+        fork_tip,
+        fork_tip,
+    )
+    .await;
+    finish_matched_block(
+        &fixture.chain,
+        &mut light_client,
+        &mut sync,
+        &sync_nc,
+        peer_index,
+        36,
+        fork_tip,
+    )
+    .await;
+    let state = service_state(fixture.chain.client_storage(), &fixture.script);
+    rp2_observer::emit("reorg_state_after_continuation", json!({"state": state}), "normal_filter_processing");
+    assert!(!has_cell_outpoint(&state, &fixture.a1_outpoint), "old A1 survived fork processing");
+    assert!(has_cell_outpoint(&state, &reorg_a2), "fork replacement A2R was not indexed");
+    let progress = fixture
+        .chain
+        .client_storage()
+        .get_filter_scripts()
+        .into_iter()
+        .find(|ss| ss.script == fixture.script && ss.script_type == StorageScriptType::Lock)
+        .map(|ss| ss.block_number)
+        .expect("A progress after fork");
+    rp2_observer::emit(
+        "reorg_continuation_observed",
+        json!({
+            "fork_point": 33,
+            "filter_request_starts": starts,
+            "old_a1_removed": !has_cell_outpoint(&state, &fixture.a1_outpoint),
+            "replacement_a2_live": has_cell_outpoint(&state, &reorg_a2),
+            "progress": progress,
+            "raw_script_index_row_count": raw_script_index_count(fixture.chain.client_storage(), &fixture.script),
+        }),
+        "normal_filter_processing",
+    );
+    json!({
+        "fork_point": 33,
+        "old_main_tip": authority.height,
+        "fork_tip": fork_tip,
+        "reorg_a2_outpoint": format!("{:#x}", reorg_a2),
+        "state_after": state,
+        "filter_request_starts": starts,
+        "progress_after": progress,
+        "old_a1_removed": !has_cell_outpoint(&state, &fixture.a1_outpoint),
+        "replacement_a2_live": has_cell_outpoint(&state, &reorg_a2),
+        "reorg_protocol_selected": true,
+    })
+}
