+async fn rp2d_losing_artifact_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let artifact = PathBuf::from(rp2c_required_env("RP2C_ARTIFACT"));
+    let (_fork_tip, _fork_outpoint) = append_rp2d_reorg_branch(&fixture);
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let authority = establish_authority(&fixture.chain, &mut light_client, &nc, peer_index, 38).await;
+    let _events = start_events(&case, "AUTHORITY_INVALID", true);
+    let before = chain_authority_fingerprint(fixture.chain.client_storage());
+    let (_envelope, handoff, digest) = read_artifact(&artifact).expect("read losing-fork artifact");
+    let destination = DestinationAuthority { genesis_hash: authority.genesis, height: authority.height, hash: authority.hash };
+    let rejection = fixture.chain.client_storage().import_typed_script_handoff(&handoff, &destination);
+    assert!(rejection.is_err(), "old-branch artifact was accepted on winning chain");
+    let after = chain_authority_fingerprint(fixture.chain.client_storage());
+    assert_eq!(before, after, "losing artifact mutated authority");
+    rp2_observer::emit("authority_validation_rejected", json!({"reason": "handoff hash is not the destination winning-chain hash", "artifact_digest": digest}), "import_validation");
+    rp2_observer::emit("authority_fingerprint_unchanged", json!({"unchanged": true}), "independent_authority_observer");
+    rp2c_output(json!({"mode": "losing-artifact-rejected", "case": case, "backend": BACKEND, "rejected": true, "authority_unchanged": before == after, "artifact_digest": digest, "destination_height": authority.height}));
+}
