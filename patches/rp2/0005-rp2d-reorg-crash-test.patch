+async fn rp2d_deep_fork_worker() {
+    let fixture = make_fixture();
+    let case = rp2c_required_env("RP2C_CASE");
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let authority = establish_authority(&fixture.chain, &mut light_client, &nc, peer_index, fixture.tip_height).await;
+    // Diagnostic only: fork beyond the retained last-N header window. The
+    // destination must either reject it or handle it through an explicit
+    // upstream limitation; it must never silently mutate authority.
+    const DEEP_FORK_POINT: BlockNumber = 20;
+    const DEEP_TIP: BlockNumber = 38;
+    fixture.chain.rollback_to(DEEP_FORK_POINT, Default::default());
+    fixture.chain.tx_pool().clear_pool(Arc::clone(&*fixture.chain.shared().snapshot())).expect("clear detached deep-fork txpool");
+    let construction = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        for _ in (DEEP_FORK_POINT + 1)..=DEEP_TIP { fixture.chain.mine_block(deterministic_timestamped_block); }
+    }));
+    if construction.is_err() {
+        rp2c_output(json!({"mode": "deep-fork-diagnostic", "case": case, "backend": BACKEND, "fork_point": DEEP_FORK_POINT, "old_tip": authority.height, "new_tip": DEEP_TIP, "protocol_selected": false, "peer_banned": false, "authority_fingerprint": chain_authority_fingerprint(fixture.chain.client_storage()), "classification": "UPSTREAM_LIMIT_OR_REJECTED", "construction": "upstream fixture rejected deeper branch"}));
+        return;
+    }
+    let prove_request = fixture.chain.build_prove_request(authority.height, DEEP_TIP, &[], DEEP_TIP - LAST_N_BLOCKS + 1, LAST_N_BLOCKS);
+    peers.update_last_state(peer_index, LastState::new(prove_request.get_last_header().to_owned())).unwrap();
+    peers.update_prove_request(peer_index, prove_request).unwrap();
+    let message = rp2d_reorg_headers_and_proof(&fixture, authority.height, DEEP_TIP, LAST_N_BLOCKS);
+    light_client.received(nc.context(), peer_index, message.as_bytes()).await;
+    let after = chain_authority_fingerprint(fixture.chain.client_storage());
+    let selected = match light_client.get_peer_state(&peer_index) {
+        Ok(state) => state
+            .get_prove_state()
+            .map(|prove| prove.get_last_header().header().number() == DEEP_TIP)
+            .unwrap_or(false),
+        Err(_) => false,
+    };
+    rp2c_output(json!({"mode": "deep-fork-diagnostic", "case": case, "backend": BACKEND, "fork_point": DEEP_FORK_POINT, "old_tip": authority.height, "new_tip": DEEP_TIP, "protocol_selected": selected, "peer_banned": !nc.not_banned(peer_index), "authority_fingerprint": after, "classification": if selected { "RETAINED_OR_ACCEPTED" } else { "UPSTREAM_LIMIT_OR_REJECTED" }}));
+}
