+async fn rp2d_simultaneous_import_worker() {
+    let fixture = make_fixture();
+    let artifact_path = PathBuf::from(rp2d_required_env("RP2C_ARTIFACT"));
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut light_client = fixture.chain.create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(&fixture.chain, &mut light_client, &nc, peer_index, fixture.tip_height).await;
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script_b(), ServiceScriptType::Lock, receipt.height);
+    register_script_at_through_service(&fixture.chain, Arc::clone(&peers), &script_a(), ServiceScriptType::Type, receipt.height);
+    drop(light_client);
+    let (_envelope, handoff, digest) = read_artifact(&artifact_path).expect("read simultaneous artifact");
+    let authority = DestinationAuthority { genesis_hash: receipt.genesis, height: receipt.height, hash: receipt.hash };
+    let before = chain_authority_fingerprint(fixture.chain.client_storage());
+    std::env::set_var("RP2D_IMPORT_HOLD_MS", "250");
+    let storage_one = fixture.chain.client_storage().clone();
+    let handoff_one = handoff.clone();
+    let authority_one = authority.clone();
+    let first = std::thread::spawn(move || storage_one.import_typed_script_handoff(&handoff_one, &authority_one));
+    std::thread::sleep(std::time::Duration::from_millis(40));
+    let storage_two = fixture.chain.client_storage().clone();
+    let handoff_two = handoff.clone();
+    let authority_two = authority.clone();
+    let second = std::thread::spawn(move || storage_two.import_typed_script_handoff(&handoff_two, &authority_two));
+    let first_result = first.join().expect("first import thread should join");
+    let second_result = second.join().expect("second import thread should join");
+    std::env::remove_var("RP2D_IMPORT_HOLD_MS");
+    assert!(first_result.is_ok(), "one simultaneous valid import must commit: {first_result:?}");
+    assert!(second_result.is_err(), "simultaneous duplicate import must be busy/rejected");
+    let retry = fixture.chain.client_storage().import_typed_script_handoff(&handoff, &authority).expect("duplicate retry should be idempotent");
+    assert!(retry.idempotent);
+    let mut conflicting = handoff.clone();
+    conflicting.progress.cursor = conflicting.progress.cursor.saturating_sub(1);
+    let conflict = fixture.chain.client_storage().import_typed_script_handoff(&conflicting, &authority);
+    assert!(conflict.is_err(), "conflicting import unexpectedly accepted");
+    let after = chain_authority_fingerprint(fixture.chain.client_storage());
+    let state = service_state(fixture.chain.client_storage(), &script_a());
+    assert!(has_cell_outpoint(&state, &fixture.a1_outpoint));
+    assert_eq!(before, after, "simultaneous imports mutated authority");
+    rp2c_output(json!({
+        "mode": "simultaneous-import",
+        "backend": BACKEND,
+        "artifact_digest": digest,
+        "same_artifact": {"first_committed": true, "second_rejected_busy": true, "retry_idempotent": retry.idempotent},
+        "conflicting_artifact": {"rejected_after_winner": true, "reason": conflict.err().map(|err| err.to_string())},
+        "persisted_state_coherent": true,
+        "authority_unchanged": before == after,
+        "unrelated_script_preserved": true,
+    }));
+}
