+fn rp2d_reorg_headers_and_proof(
+    fixture: &Fixture,
+    prev_number: BlockNumber,
+    last_number: BlockNumber,
+    last_n_blocks: BlockNumber,
+) -> packed::LightClientMessage {
+    let snapshot = fixture.chain.shared().snapshot();
+    let boundary_number = if last_number > last_n_blocks + 1 {
+        last_number - last_n_blocks + 1
+    } else {
+        1
+    };
+    let boundary_number = boundary_number.min(prev_number);
+    let first_last_n_number = if last_number > last_n_blocks {
+        boundary_number.min(last_number - last_n_blocks)
+    } else {
+        1
+    };
+    let reorg_start = prev_number.saturating_sub(last_n_blocks);
+    let reorg_numbers = (reorg_start..prev_number)
+        .filter(|number| *number < first_last_n_number)
+        .collect::<Vec<_>>();
+    let headers = reorg_numbers
+        .into_iter()
+        .chain(first_last_n_number..last_number)
+        .map(|number| {
+            snapshot
+                .get_verifiable_header_by_number(number)
+                .expect("fork header stored")
+        })
+        .collect::<Vec<_>>();
+    let last_header = snapshot
+        .get_verifiable_header_by_number(last_number)
+        .expect("fork tip stored");
+    let numbers = headers
+        .iter()
+        .map(|header| header.header().raw().number().unpack())
+        .collect::<Vec<BlockNumber>>();
+    let proof = fixture.chain.build_proof_by_numbers(last_number, &numbers);
+    packed::LightClientMessage::new_builder()
+        .set(
+            packed::SendLastStateProof::new_builder()
+                .last_header(last_header)
+                .proof(proof)
+                .headers(headers.pack())
+                .build(),
+        )
+        .build()
+}
