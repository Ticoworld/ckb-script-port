+// The RP2 handoff is a test-only storage seam.  Keep its lifecycle state
+// outside the backend schema and share it across every Storage clone (and
+// every same-process reopen of the same path) so protocol activity and import
+// ownership cannot be silently interleaved.
+#[cfg(all(test, not(target_arch = "wasm32")))]
+#[derive(Default)]
+pub(crate) struct ImportLifecycle {
+    state: StdMutex<ImportLifecycleState>,
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+#[derive(Default)]
+struct ImportLifecycleState {
+    active_workers: usize,
+    importing: bool,
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+pub(crate) struct ProtocolActivityGuard {
+    lifecycle: Arc<ImportLifecycle>,
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+pub(crate) struct OfflineImportGuard {
+    lifecycle: Arc<ImportLifecycle>,
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+impl ImportLifecycle {
+    fn acquire_protocol(self: &Arc<Self>) -> Result<ProtocolActivityGuard, String> {
+        let mut state = self.state.lock().map_err(|_| "lifecycle mutex poisoned".to_owned())?;
+        if state.importing {
+            return Err("normal protocol activity cannot start during handoff import".to_owned());
+        }
+        state.active_workers += 1;
+        Ok(ProtocolActivityGuard { lifecycle: Arc::clone(self) })
+    }
+
+    fn acquire_import(self: &Arc<Self>) -> Result<OfflineImportGuard, String> {
+        let mut state = self.state.lock().map_err(|_| "lifecycle mutex poisoned".to_owned())?;
+        if state.importing {
+            return Err("another handoff import already owns the destination".to_owned());
+        }
+        if state.active_workers != 0 {
+            return Err("handoff import requires an exclusive offline destination".to_owned());
+        }
+        state.importing = true;
+        Ok(OfflineImportGuard { lifecycle: Arc::clone(self) })
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+impl Drop for ProtocolActivityGuard {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.lifecycle.state.lock() {
+            state.active_workers = state.active_workers.saturating_sub(1);
+        }
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+impl Drop for OfflineImportGuard {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.lifecycle.state.lock() {
+            state.importing = false;
+        }
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+static IMPORT_LIFECYCLES: OnceLock<StdMutex<StdHashMap<String, Arc<ImportLifecycle>>>> = OnceLock::new();
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+pub(crate) fn import_lifecycle_for_path<P: AsRef<Path>>(path: P) -> Arc<ImportLifecycle> {
+    let key = path.as_ref().to_string_lossy().to_string();
+    let map = IMPORT_LIFECYCLES.get_or_init(|| StdMutex::new(StdHashMap::new()));
+    let mut map = map.lock().expect("import lifecycle map should not be poisoned");
+    Arc::clone(map.entry(key).or_insert_with(|| Arc::new(ImportLifecycle::default())))
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+pub(crate) fn rp2d_commit_signal(stage: &str) {
+    let Ok(path) = std::env::var("RP2D_COMMIT_SIGNAL") else { return };
+    use std::io::Write;
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .expect("RP2-D commit signal should open");
+    writeln!(file, "{stage}").expect("RP2-D commit signal should write");
+    file.flush().expect("RP2-D commit signal should flush");
+    file.sync_all().expect("RP2-D commit signal should sync");
+}
