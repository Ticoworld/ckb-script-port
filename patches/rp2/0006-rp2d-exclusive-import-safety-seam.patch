+    }));
+    if construction.is_err() {
+        rp2c_output(json!({"mode": "deep-fork-diagnostic", "case": case, "backend": BACKEND, "fork_point": DEEP_FORK_POINT, "old_tip": authority.height, "new_tip": DEEP_TIP, "protocol_selected": false, "peer_banned": false, "authority_fingerprint": chain_authority_fingerprint(fixture.chain.client_storage()), "classification": "UPSTREAM_LIMIT_OR_REJECTED", "construction": "upstream fixture rejected deeper branch"}));
