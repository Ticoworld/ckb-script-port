+    }
+    let prove_request = fixture.chain.build_prove_request(authority.height, DEEP_TIP, &[], DEEP_TIP - LAST_N_BLOCKS + 1, LAST_N_BLOCKS);
+    peers.update_last_state(peer_index, LastState::new(prove_request.get_last_header().to_owned())).unwrap();
+    peers.update_prove_request(peer_index, prove_request).unwrap();
