+#[tokio::test(flavor = "multi_thread")]
+async fn rp2a_chain_binding_rejects_wrong_hash_genesis_role_and_height() {
+    setup();
+    let _events = start_events("adv-5-8-chain-binding", "AUTHORITY_INVALID", true);
+    let fixture = make_fixture();
+    let peers = fixture.chain.create_peers();
+    let peer_index = PeerIndex::new(1);
+    peers.add_peer(peer_index);
+    peers.request_last_state(peer_index).unwrap();
+    let mut protocol = fixture
+        .chain
+        .create_light_client_protocol(Arc::clone(&peers));
+    let nc = MockNetworkContext::new(SupportProtocols::LightClient);
+    let receipt = establish_authority(
+        &fixture.chain,
+        &mut protocol,
+        &nc,
+        peer_index,
+        fixture.tip_height,
+    )
+    .await;
+    let before = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("before_rejected_claims", &before);
+    let expected_genesis = receipt.genesis.clone();
+    let cases = vec![
+        (
+            "same_height_wrong_hash",
+            HandoffClaim {
+                script: fixture.script.clone(),
+                lock_role: true,
+                height: receipt.height,
+                hash: packed::Byte32::from_slice(&[1u8; 32]).unwrap(),
+                genesis: expected_genesis.clone(),
+            },
+        ),
+        (
+            "wrong_genesis",
+            HandoffClaim {
+                script: fixture.script.clone(),
+                lock_role: true,
+                height: receipt.height,
+                hash: receipt.hash.clone(),
+                genesis: packed::Byte32::from_slice(&[2u8; 32]).unwrap(),
+            },
+        ),
+        (
+            "cursor_beyond_verified",
+            HandoffClaim {
+                script: fixture.script.clone(),
+                lock_role: true,
+                height: receipt.height + 1,
+                hash: receipt.hash.clone(),
+                genesis: expected_genesis.clone(),
+            },
+        ),
+        (
+            "wrong_role",
+            HandoffClaim {
+                script: fixture.script.clone(),
+                lock_role: false,
+                height: receipt.height,
+                hash: receipt.hash.clone(),
+                genesis: expected_genesis.clone(),
+            },
+        ),
+        (
+            "wrong_script",
+            HandoffClaim {
+                script: Script::new_builder()
+                    .code_hash(ALWAYS_SUCCESS_SCRIPT.code_hash())
+                    .hash_type(ScriptHashType::Data)
+                    .args(Bytes::from_static(b"wrong-script").pack())
+                    .build(),
+                lock_role: true,
+                height: receipt.height,
+                hash: receipt.hash.clone(),
+                genesis: expected_genesis,
+            },
+        ),
+    ];
+    let case_count = cases.len();
+    for (name, claim) in cases {
+        let result = validate_claim(
+            fixture.chain.client_storage(),
+            Some(&receipt),
+            &claim,
+            &fixture.script,
+            true,
+        );
+        assert!(
+            result.is_err(),
+            "adversarial claim unexpectedly accepted: {name}"
+        );
+        rp2_observer::emit(
+            "handoff_validation_rejected",
+            json!({"case": name, "reason": result.unwrap_err()}),
+            "approved_validation",
+        );
+    }
+    let after = authority_fingerprint(fixture.chain.client_storage());
+    record_fingerprint("after_rejected_claims", &after);
+    assert_eq!(before, after, "rejected claims changed authority state");
+    rp2_observer::emit(
+        "authority_fingerprint_unchanged",
+        json!({"unchanged": before == after}),
+        "approved_validation",
+    );
+    write_result(
+        "chain-binding",
+        json!({"case": "chain-binding", "rejected": case_count, "authority_unchanged": before == after}),
+    );
+}
