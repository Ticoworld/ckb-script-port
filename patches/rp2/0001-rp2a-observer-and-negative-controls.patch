new file mode 100644
index 0000000..f390cdd
--- /dev/null
+++ b/light-client-lib/src/rp2_observer.rs
@@ -0,0 +1,110 @@
+//! Test-only structured observation for the RP2-A authority/replay harness.
+//!
+//! This module is compiled only for tests. It records observations made at
+//! real upstream protocol/storage boundaries and does not change decisions.
+
+use serde::Serialize;
+use serde_json::Value;
+use std::cell::RefCell;
+use std::fs::{create_dir_all, File};
+use std::io::{self, BufWriter, Write};
+use std::path::Path;
+use std::sync::{Mutex, OnceLock};
+
+const SCHEMA_VERSION: u32 = 1;
+
+#[derive(Serialize)]
+struct EventRecord {
+    schema_version: u32,
+    run_id: String,
+    client_id: String,
+    backend: String,
+    sequence: u64,
+    event_type: String,
+    origin: String,
+    fields: Value,
+}
+
+struct EventWriter {
+    run_id: String,
+    client_id: String,
+    backend: String,
+    sequence: u64,
+    writer: BufWriter<File>,
+}
+
+static WRITER: OnceLock<Mutex<Option<EventWriter>>> = OnceLock::new();
+
+thread_local! {
+    static ORIGIN: RefCell<Option<String>> = const { RefCell::new(None) };
+}
+
+fn writer() -> &'static Mutex<Option<EventWriter>> {
+    WRITER.get_or_init(|| Mutex::new(None))
+}
+
+pub(crate) fn start<P: AsRef<Path>>(
+    path: P,
+    run_id: impl Into<String>,
+    client_id: impl Into<String>,
+    backend: impl Into<String>,
+) -> io::Result<()> {
+    if let Some(parent) = path.as_ref().parent() {
+        create_dir_all(parent)?;
+    }
+    let file = File::create(path)?;
+    *writer().lock().expect("RP2 observer lock") = Some(EventWriter {
+        run_id: run_id.into(),
+        client_id: client_id.into(),
+        backend: backend.into(),
+        sequence: 0,
+        writer: BufWriter::new(file),
+    });
+    Ok(())
+}
+
+pub(crate) fn finish() -> io::Result<()> {
+    let mut guard = writer().lock().expect("RP2 observer lock");
+    if let Some(mut event_writer) = guard.take() {
+        event_writer.writer.flush()?;
+    }
+    Ok(())
+}
+
+pub(crate) fn with_origin<R>(origin: &str, f: impl FnOnce() -> R) -> R {
+    let previous = ORIGIN.with(|cell| cell.replace(Some(origin.to_owned())));
+    let result = f();
+    ORIGIN.with(|cell| {
+        cell.replace(previous);
+    });
+    result
+}
+
+pub(crate) fn current_origin(default: &str) -> String {
+    ORIGIN
+        .with(|cell| cell.borrow().clone())
+        .unwrap_or_else(|| default.to_owned())
+}
+
+pub(crate) fn emit(event_type: &str, fields: Value, default_origin: &str) {
+    let mut guard = writer().lock().expect("RP2 observer lock");
+    let Some(event_writer) = guard.as_mut() else {
+        return;
+    };
+    event_writer.sequence += 1;
+    let record = EventRecord {
+        schema_version: SCHEMA_VERSION,
+        run_id: event_writer.run_id.clone(),
+        client_id: event_writer.client_id.clone(),
+        backend: event_writer.backend.clone(),
+        sequence: event_writer.sequence,
+        event_type: event_type.to_owned(),
+        origin: current_origin(default_origin),
+        fields,
+    };
+    serde_json::to_writer(&mut event_writer.writer, &record).expect("write RP2 event");
+    event_writer
+        .writer
+        .write_all(b"\n")
+        .expect("write RP2 event newline");
+}
